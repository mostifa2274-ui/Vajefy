{"entries":[{"id":"lex:A1:again","headword":"again","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:again","pos":"adverb","gloss":"دوباره","meaning":"یک بار دیگر؛ مثل قبل. معمولاً آخر جمله می‌آید.","grammar":[{"pattern":"verb + again","note":"Say it again."},{"pattern":"again and again","note":"بارها و بارها"},{"pattern":"never again","note":"دیگر هرگز"}],"examples":[{"en":"Can you say that again, please?","fa":"می‌شود لطفاً دوباره بگویید؟"},{"en":"I want to see that film again.","fa":"می‌خواهم آن فیلم را دوباره ببینم."}],"collocations":["say it again","try again","again and again","never again"],"mistake":{"wrong":"Please repeat again.","right":"Please say it again. / Please repeat.","why":"repeat خودش یعنی «دوباره گفتن»؛ again لازم نیست."},"pronunciation":{"gb":"/əˈɡen/","us":"/əˈɡen/","note":"«اِگِن»؛ بریتانیایی‌ها گاهی «اِگِین» هم می‌گویند."},"check":[{"type":"cloze","id":"c1","text":"I didn't hear you. Can you say it ___?","answer":"again","accept":[],"fa":"نشنیدم. می‌شود دوباره بگویی؟","why":"again = دوباره."},{"type":"choice","id":"q1","prompt":"The answer is wrong. Please try ___.","options":[{"text":"again","ok":true,"why":"try again = دوباره امتحان کن."},{"text":"another","ok":false,"why":"another بعدش اسم می‌خواهد."},{"text":"more","ok":false,"why":"try more معنای «دوباره» نمی‌دهد."}]},{"type":"produce","id":"p1","prompt":"فردا دوباره زنگ می‌زنم.","frame":"I'll call ___ tomorrow.","answer":"again","accept":[],"why":"again = دوباره."}]}],"version":"e9f970dbb94c","order":400,"released":false},{"id":"lex:A1:agree","headword":"agree","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:agree","pos":"verb","gloss":"موافق بودن؛ قبول کردن","meaning":"همان نظر را داشتن. agree with + شخص؛ agree to + فعل = قبول کردن که کاری را بکنی. agree فعل است، پس I agree (نه I am agree).","grammar":[{"pattern":"agree with + person","note":"I agree with you."},{"pattern":"agree to + verb","note":"He agreed to help."},{"pattern":"agree about + topic","note":"We agree about most things."}],"examples":[{"en":"I agree with you. It's a good idea.","fa":"با تو موافقم. فکر خوبی است."},{"en":"My father agreed to drive us to the airport.","fa":"پدرم قبول کرد ما را به فرودگاه برساند."}],"collocations":["agree with","agree to","I agree","completely agree"],"mistake":{"wrong":"I am agree with you.","right":"I agree with you.","why":"agree فعل است؛ am لازم نیست."},"pronunciation":{"gb":"/əˈɡriː/","us":"/əˈɡriː/","note":"تکیه روی بخش دوم است: «اِگری»."},"check":[{"type":"cloze","id":"c1","text":"I ___ with you. It's too expensive.","answer":"agree","accept":[],"fa":"با تو موافقم. خیلی گران است.","why":"agree with."},{"type":"choice","id":"q1","prompt":"Do you ___ with me?","options":[{"text":"agree","ok":true,"why":"Do you + فعل ساده."},{"text":"are agree","ok":false,"why":"agree فعل است و be نمی‌خواهد."},{"text":"agreeing","ok":false,"why":"بعد از Do you فعل ساده می‌آید."}]},{"type":"produce","id":"p1","prompt":"با او موافق نیستم.","frame":"I don't ___ with him.","answer":"agree","accept":[],"why":"don't agree with."}]}],"version":"58bc6608dd43","order":401,"released":false},{"id":"lex:A1:arrive","headword":"arrive","goals":["everyday","general"],"senses":[{"id":"lex:A1:arrive","pos":"verb","gloss":"رسیدن","meaning":"به جایی رسیدن. arrive at برای جای کوچک (ایستگاه، فرودگاه، مدرسه)، arrive in برای شهر و کشور. arrive home بدون حرف اضافه. arrive to نمی‌گوییم.","grammar":[{"pattern":"arrive at + place","note":"arrive at the station"},{"pattern":"arrive in + city / country","note":"arrive in Tehran"},{"pattern":"arrive home / here / there","note":"بدون حرف اضافه"}],"examples":[{"en":"The train arrives at six.","fa":"قطار ساعت شش می‌رسد."},{"en":"We arrived in London late at night.","fa":"دیروقت شب به لندن رسیدیم."}],"collocations":["arrive at","arrive in","arrive home","arrive late"],"mistake":{"wrong":"We arrived to the airport at ten.","right":"We arrived at the airport at ten.","why":"با arrive، to نمی‌آید؛ at یا in."},"pronunciation":{"gb":"/əˈraɪv/","us":"/əˈraɪv/","note":"تکیه روی بخش دوم است: «اِرایو»."},"check":[{"type":"cloze","id":"c1","text":"What time does your plane ___ in Tehran?","answer":"arrive","accept":["land"],"fa":"هواپیمایت چه ساعتی به تهران می‌رسد؟","why":"arrive in + شهر."},{"type":"choice","id":"q1","prompt":"They arrived ___ Paris on Monday.","options":[{"text":"in","ok":true,"why":"برای شهر: arrive in."},{"text":"to","ok":false,"why":"arrive to غلط است."},{"text":"on","ok":false,"why":"arrive on Paris غلط است؛ برای شهر in می‌آید."}]},{"type":"produce","id":"p1","prompt":"دیر به خانه رسیدم.","frame":"I ___ home late.","answer":"arrived","accept":[],"why":"arrive home، بدون حرف اضافه."}]}],"version":"afde182a93c5","order":402,"released":false},{"id":"lex:A1:bed","headword":"bed","goals":["everyday","general"],"senses":[{"id":"lex:A1:bed","pos":"noun","gloss":"تخت؛ رختخواب","meaning":"وسیله‌ای که روی آن می‌خوابید. go to bed = به رختخواب رفتن (بدون the). in bed = در رختخواب.","grammar":[{"pattern":"go to bed","note":"خوابیدن؛ بدون the"},{"pattern":"in bed","note":"در رختخواب"},{"pattern":"make the bed","note":"رختخواب را مرتب کردن"}],"examples":[{"en":"I usually go to bed at eleven.","fa":"معمولاً ساعت یازده می‌خوابم."},{"en":"My little sister is still in bed.","fa":"خواهر کوچکم هنوز در رختخواب است."}],"collocations":["go to bed","in bed","make the bed","a double bed"],"mistake":{"wrong":"I go to the bed at ten.","right":"I go to bed at ten.","why":"go to bed بدون the."},"pronunciation":{"gb":"/bed/","us":"/bed/"},"check":[{"type":"cloze","id":"c1","text":"It's late. Time for ___!","answer":"bed","accept":[],"fa":"دیر است. وقت خواب است!","why":"time for bed."},{"type":"choice","id":"q1","prompt":"I read a book ___ bed every night.","options":[{"text":"in","ok":true,"why":"«در رختخواب» = in bed."},{"text":"on","ok":false,"why":"on bed بدون the غلط است."},{"text":"at","ok":false,"why":"at bed غلط است."}]},{"type":"produce","id":"p1","prompt":"ساعت ده می‌خوابم.","frame":"I go to ___ at ten.","answer":"bed","accept":[],"why":"go to bed."}]}],"version":"b98c18789b24","order":403,"released":false},{"id":"lex:A1:blue","headword":"blue","goals":["everyday","general"],"senses":[{"id":"lex:A1:blue","pos":"adjective","gloss":"آبی","meaning":"رنگ آسمانِ صاف یا دریا. light blue = آبی روشن؛ dark blue = سرمه‌ای. بی‌اسم هم می‌آید: Blue is my favourite colour.","grammar":[{"pattern":"blue + noun","note":"a blue shirt"},{"pattern":"be blue","note":"The sky is blue."},{"pattern":"light / dark blue","note":"آبی روشن / سرمه‌ای"}],"examples":[{"en":"She's wearing a blue dress.","fa":"او یک لباس آبی پوشیده."},{"en":"The sea is very blue today.","fa":"امروز دریا خیلی آبی است."}],"collocations":["light blue","dark blue","blue sky","blue eyes"],"mistake":{"wrong":"I have a shirt blue.","right":"I have a blue shirt.","why":"صفتِ رنگ قبل از اسم می‌آید."},"pronunciation":{"gb":"/bluː/","us":"/bluː/"},"check":[{"type":"cloze","id":"c1","text":"The sky is ___ and there are no clouds.","answer":"blue","accept":["clear"],"fa":"آسمان آبی است و ابری نیست.","why":"blue = آبی."},{"type":"choice","id":"q1","prompt":"He has big ___ eyes.","options":[{"text":"blue","ok":true,"why":"صفت قبل از اسم."},{"text":"blues","ok":false,"why":"صفت s جمع نمی‌گیرد."},{"text":"bluely","ok":false,"why":"bluely وجود ندارد."}]},{"type":"produce","id":"p1","prompt":"ماشینش آبی است.","frame":"His car is ___.","answer":"blue","accept":[],"why":"blue = آبی."}]}],"version":"07d2c0d84afc","order":404,"released":false},{"id":"lex:A1:bottle","headword":"bottle","goals":["everyday","general"],"senses":[{"id":"lex:A1:bottle","pos":"noun","gloss":"بطری","meaning":"ظرفی شیشه‌ای یا پلاستیکی با گردن باریک برای مایعات. a bottle of water = یک بطری آب.","grammar":[{"pattern":"a bottle of + noun","note":"a bottle of water"},{"pattern":"a water / milk bottle","note":"بطری آب / شیر"},{"pattern":"bottles","note":"جمع"}],"examples":[{"en":"Can I have a bottle of water, please?","fa":"می‌شود یک بطری آب بدهید؟"},{"en":"Put the empty bottles in the box.","fa":"بطری‌های خالی را در جعبه بگذار."}],"collocations":["a bottle of water","a plastic bottle","an empty bottle","open a bottle"],"mistake":{"wrong":"I bought two waters bottle.","right":"I bought two bottles of water.","why":"جمع روی bottle می‌آید: two bottles of water."},"pronunciation":{"gb":"/ˈbɒtl/","us":"/ˈbɑːtl/"},"check":[{"type":"cloze","id":"c1","text":"Don't throw away that plastic ___. We can use it again.","answer":"bottle","accept":[],"fa":"آن بطری پلاستیکی را دور نینداز. می‌توانیم دوباره استفاده‌اش کنیم.","why":"a plastic bottle."},{"type":"choice","id":"q1","prompt":"We need two ___ of milk.","options":[{"text":"bottles","ok":true,"why":"بعد از two جمع می‌آید."},{"text":"bottle","ok":false,"why":"بعد از two اسم جمع لازم است."},{"text":"bottels","ok":false,"why":"املای درست bottles است."}]},{"type":"produce","id":"p1","prompt":"یک بطری آب بخر.","frame":"Buy a ___ of water.","answer":"bottle","accept":[],"why":"a bottle of water."}]}],"version":"9fbb4ef58fe6","order":405,"released":false},{"id":"lex:A1:busy","headword":"busy","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:busy","pos":"adjective","gloss":"مشغول؛ پرمشغله؛ شلوغ","meaning":"کسی که کار زیادی دارد و وقت ندارد؛ یا جایی که شلوغ است. busy + -ing = مشغولِ کاری.","grammar":[{"pattern":"be busy","note":"I'm busy today."},{"pattern":"busy with + noun","note":"busy with work"},{"pattern":"busy + -ing","note":"busy cooking"}],"examples":[{"en":"Sorry, I can't talk now. I'm busy.","fa":"ببخشید، الان نمی‌توانم حرف بزنم. سرم شلوغ است."},{"en":"This street is very busy in the evening.","fa":"این خیابان عصرها خیلی شلوغ است."}],"collocations":["very busy","a busy day","a busy street","busy with"],"mistake":{"wrong":"I'm busy to cook dinner.","right":"I'm busy cooking dinner.","why":"بعد از busy، فعل با -ing می‌آید."},"pronunciation":{"gb":"/ˈbɪzi/","us":"/ˈbɪzi/","note":"u مثل «ای» خوانده می‌شود: «بیزی»."},"check":[{"type":"c