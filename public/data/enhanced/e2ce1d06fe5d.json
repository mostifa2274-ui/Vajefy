{"entries":[{"id":"lex:A1:chart","headword":"chart","goals":["study","general"],"senses":[{"id":"lex:A1:chart","pos":"noun","gloss":"نمودار","meaning":"تصویری با خط، ستون یا جدول که اطلاعات را نشان می‌دهد. the chart shows … = نمودار نشان می‌دهد …","grammar":[{"pattern":"look at the chart","note":"به نمودار نگاه کردن"},{"pattern":"on the chart","note":"روی نمودار"},{"pattern":"the chart shows …","note":"نمودار نشان می‌دهد …"}],"examples":[{"en":"Look at the chart and answer the questions.","fa":"به نمودار نگاه کن و به سؤال‌ها جواب بده."},{"en":"The chart shows how many students walk to school.","fa":"نمودار نشان می‌دهد چند دانش‌آموز پیاده به مدرسه می‌روند."}],"collocations":["a chart of","the chart shows","on the chart","make a chart"],"mistake":{"wrong":"Look the chart.","right":"Look at the chart.","why":"look بدون at مفعول نمی‌گیرد: look at the chart."},"pronunciation":{"gb":"/tʃɑːt/","us":"/tʃɑːrt/"},"check":[{"type":"cloze","id":"c1","text":"The ___ shows the weather for each day of the week.","answer":"chart","accept":["table","picture"],"fa":"نمودار هوای هر روزِ هفته را نشان می‌دهد.","why":"the chart shows."},{"type":"choice","id":"q1","prompt":"You can see the numbers ___ the chart.","options":[{"text":"on","ok":true,"why":"on the chart."},{"text":"at","ok":false,"why":"at the chart اینجا غلط است."},{"text":"to","ok":false,"why":"to the chart غلط است."}]},{"type":"produce","id":"p1","prompt":"نمودار را ببین.","frame":"Look at the ___.","answer":"chart","accept":[],"why":"look at the chart."}]}],"version":"8f5c60e0b375","order":725,"released":false},{"id":"lex:A1:chocolate","headword":"chocolate","goals":["everyday","general"],"senses":[{"id":"lex:A1:chocolate","pos":"noun","gloss":"شکلات","meaning":"خوراکیِ شیرین و قهوه‌ای. به‌طور کلی غیرقابل‌شمارش است (some chocolate)؛ a chocolate یعنی یک دانه شکلات.","grammar":[{"pattern":"chocolate (uncountable)","note":"some chocolate"},{"pattern":"a chocolate / chocolates","note":"دانه‌های شکلات"},{"pattern":"chocolate + noun","note":"chocolate cake"}],"examples":[{"en":"Do you want a piece of chocolate?","fa":"یک تکه شکلات می‌خواهی؟"},{"en":"She bought a box of chocolates for her mother.","fa":"او برای مادرش یک جعبه شکلات خرید."}],"collocations":["a bar of chocolate","hot chocolate","chocolate cake","a box of chocolates"],"mistake":{"wrong":"I eat too many chocolate.","right":"I eat too much chocolate.","why":"chocolate به‌طور کلی غیرقابل‌شمارش است: much."},"pronunciation":{"gb":"/ˈtʃɒklət/","us":"/ˈtʃɑːklət/"},"check":[{"type":"cloze","id":"c1","text":"It's cold today. I'd like a hot ___, please.","answer":"chocolate","accept":["tea","coffee","drink"],"fa":"امروز سرد است. یک شیرکاکائوی داغ می‌خواهم، لطفاً.","why":"hot chocolate."},{"type":"choice","id":"q1","prompt":"Don't eat too ___ chocolate.","options":[{"text":"much","ok":true,"why":"غیرقابل‌شمارش: much."},{"text":"many","ok":false,"why":"many با غیرقابل‌شمارش نمی‌آید."},{"text":"a lot","ok":false,"why":"too a lot غلط است."}]},{"type":"produce","id":"p1","prompt":"کیک شکلاتی دوست دارم.","frame":"I love ___ cake.","answer":"chocolate","accept":[],"why":"chocolate cake."}]}],"version":"cc13fec04265","order":726,"released":false},{"id":"lex:A1:cinema","headword":"cinema","goals":["everyday","general"],"senses":[{"id":"lex:A1:cinema","pos":"noun","gloss":"سینما","meaning":"جایی که فیلم نشان می‌دهند. go to the cinema = به سینما رفتن. آمریکایی‌ها movie theater می‌گویند.","grammar":[{"pattern":"go to the cinema","note":"به سینما رفتن"},{"pattern":"at the cinema","note":"در سینما"},{"pattern":"cinema / film","note":"سینما / فیلم"}],"examples":[{"en":"Let's go to the cinema tonight.","fa":"بیا امشب به سینما برویم."},{"en":"What's on at the cinema this week?","fa":"این هفته سینما چه فیلمی نشان می‌دهد؟"}],"collocations":["go to the cinema","at the cinema","a cinema ticket","the local cinema"],"mistake":{"wrong":"We went to cinema.","right":"We went to the cinema.","why":"go to the cinema با the."},"pronunciation":{"gb":"/ˈsɪnəmə/","us":"/ˈsɪnəmə/"},"check":[{"type":"cloze","id":"c1","text":"We watched a great film at the ___ last night.","answer":"cinema","accept":["theatre","theater"],"fa":"دیشب در سینما فیلم عالی‌ای دیدیم.","why":"at the cinema."},{"type":"choice","id":"q1","prompt":"I saw that film ___ the cinema.","options":[{"text":"at","ok":true,"why":"at the cinema."},{"text":"on","ok":false,"why":"on the cinema غلط است."},{"text":"to","ok":false,"why":"to برای رفتن است، نه بودن."}]},{"type":"produce","id":"p1","prompt":"به سینما رفتیم.","frame":"We went to the ___.","answer":"cinema","accept":[],"why":"go to the cinema."}]}],"version":"ec93520bb077","order":727,"released":false},{"id":"lex:A1:college","headword":"college","goals":["study","general"],"senses":[{"id":"lex:A1:college","pos":"noun","gloss":"کالج؛ دانشکده","meaning":"جایی برای ادامهٔ تحصیل بعد از مدرسه. در آمریکا college تقریباً یعنی دانشگاه. go to college و at college بدون the.","grammar":[{"pattern":"go to college","note":"به دانشگاه رفتن؛ بدون the"},{"pattern":"at college","note":"در حال تحصیل در کالج"},{"pattern":"a college student","note":"دانشجو"}],"examples":[{"en":"My sister is at college. She studies art.","fa":"خواهرم در کالج درس می‌خواند. هنر می‌خواند."},{"en":"He wants to go to college next year.","fa":"او می‌خواهد سال بعد به دانشگاه برود."}],"collocations":["go to college","at college","a college student","finish college"],"mistake":{"wrong":"I'm student of college.","right":"I'm a college student.","why":"college قبل از student می‌آید و a لازم است."},"pronunciation":{"gb":"/ˈkɒlɪdʒ/","us":"/ˈkɑːlɪdʒ/"},"check":[{"type":"cloze","id":"c1","text":"After school, she went to ___ to study music.","answer":"college","accept":["university"],"fa":"بعد از مدرسه، برای خواندنِ موسیقی به کالج رفت.","why":"go to college."},{"type":"choice","id":"q1","prompt":"My brother is a ___ student.","options":[{"text":"college","ok":true,"why":"a college student = دانشجو."},{"text":"colleges","ok":false,"why":"قبل از student، college بدون s."},{"text":"colege","ok":false,"why":"املای درست: college."}]},{"type":"produce","id":"p1","prompt":"او در دانشگاه درس می‌خواند.","frame":"She is at ___.","answer":"college","accept":["university"],"why":"at college."}]}],"version":"6e2329afdcd5","order":728,"released":false},{"id":"lex:A1:dancing","headword":"dancing","goals":["everyday","general"],"senses":[{"id":"lex:A1:dancing","pos":"noun","gloss":"رقص؛ رقصیدن","meaning":"کارِ رقصیدن. go dancing = به رقص رفتن، بدون to. a dance یعنی یک رقص.","grammar":[{"pattern":"go dancing","note":"به رقص رفتن؛ بدون to"},{"pattern":"dancing (uncountable)","note":"رقص به‌طور کلی"},{"pattern":"dancing lessons","note":"کلاس رقص"}],"examples":[{"en":"She loves dancing.","fa":"او عاشق رقصیدن است."},{"en":"There was music and dancing at the party.","fa":"در مهمانی موسیقی و رقص بود."}],"collocations":["go dancing","dancing lessons","music and dancing","a dancing class"],"mistake":{"wrong":"We went to dancing.","right":"We went dancing.","why":"go dancing بدون to."},"pronunciation":{"gb":"/ˈdɑːnsɪŋ/","us":"/ˈdænsɪŋ/"},"tts":{"gb":"dˈɑːnsɪŋ"},"check":[{"type":"cloze","id":"c1","text":"I'm not very good at ___. I always step on people's feet.","answer":"dancing","accept":[],"fa":"رقصم خیلی خوب نیست. همیشه پایم را روی پای بقیه می‌گذارم.","why":"good at + -ing."},{"type":"choice","id":"q1","prompt":"Let's go ___ on Saturday night.","options":[{"text":"dancing","ok":true,"why":"go dancing."},{"text":"to dancing","ok":false,"why":"go dancing بدون to."},{"text":"danced","ok":false,"why":"بعد از go، -ing لازم است."}]},{"type":"produce","id":"p1","prompt":"رقص را دوست دارم.","frame":"I like ___.","answer":"dancing","accept":[],"why":"like + -ing."}]}],"version":"b5e268d5eae1","order":729,"released":false},{"id":"lex:A1:dear","headword":"dear","goals":["everyday","general"],"senses":[{"id":"lex:A1:dear","pos":"adjective","gloss":"عزیز","meaning":"عزیز. اولِ نامه: Dear Mum = مامانِ عزیز. Oh dear! = ای وای! بعد از اسمِ مخاطب ویرگول می‌آید.","grammar":[{"pattern":"Dear + name","note":"اولِ نامه"},{"pattern":"my dear + noun","note":"my dear friend"},{"pattern":"Oh dear!","note":"ای وای!"}],"examples":[{"en":"She's a dear friend of mine.","fa":"او دوستِ عزیزِ من است."},{"en":"Oh dear! I've lost my keys.","fa":"ای وای! کلیدهایم را گم کرده‌ام."}],"collocations":["Dear Sir","my dear friend","Oh dear","Dear Mum"],"mistake":{"wrong":"Dear, Mum","right":"Dear Mum,","why":"بعد از Dear ویرگول نمی‌آید؛ بعد از اسم می‌آید."},"pronunciation":{"gb":"/dɪə/","us":"/dɪr/"},"check":[{"type":"cloze","id":"c1","text":"Most letters begin with the word '___'.","answer":"Dear","accept":[],"fa":"بیشترِ نامه‌ها با کلمهٔ «Dear» شروع می‌شوند.","why":"Dear + اسم."},{"type":"choice","id":"q1","prompt":"She is a ___ friend.","options":[{"text":"dear","ok":true,"why":"a dear friend = دوستِ عزیز."},{"text":"dearly","ok":false,"why":"dearly قید است."},{"text":"dears","ok":false,"why":"صفت s نمی‌گیرد."}]},{"type":"produce","id":"p1","prompt":"دوستِ عزیزم، ممنونم.","frame":"My ___ friend, thank you.","answer":"dear","accept":[],"why":"my dear friend."}]}],"version":"d6ad3274e16b","order":730,"released":false},{"id":"lex:A1:downstairs","headword":"downstairs","goals":["everyday","general"],"senses":[{"id":"lex:A1:downstairs","pos":"adverb","gloss":"طبقهٔ پایین","meaning":"در طبقهٔ پایین، یا به طبقهٔ پایین. go downstairs بدون to. ضدش upstairs.","grammar":[{"pattern":"go / come downstairs","note":"پایین رفتن / آمدن؛ بدون to"},{"pattern":"be downstairs","note":"طبقهٔ پایین بودن"},{"pattern":"downstairs / upstairs","note":"پایین / بالا"}],"examples":[{"en":"The kitchen is downstairs.","fa":"آشپزخانه طبقهٔ پایین است."},{"en":"Come downstairs! Dinner is ready.","fa":"بیا پایین! شام آماده است."}],"collocations":["go downstairs","come downstairs","the people downstairs","run downstairs"],"mistake":{"wrong":"I went to downstairs.","right":"I went downstairs.","why":"downstairs بدون to می‌آید."},"pronunciation":{"gb":"/ˌdaʊnˈsteəz/","us":"/ˌdaʊnˈsterz/"},"check":[{"type":"cloze","id":"c1","text":"Our neighbours live ___. We can hear their TV through the floor.","answer":"downstairs","accept":[],"fa":"همسایه‌ها طبقهٔ پایین زندگی می‌کنند. صدای تلویزیون‌شان را از کف می‌شنویم.","why":"downstairs = طبقهٔ پایین."},{"type":"choice","id":"q1","prompt":"Can you go ___ and open the door?","options":[{"text":"downstairs","ok":true,"why":"go downstairs، بدون to."},{"text":"to downstairs","ok":false,"why":"downstairs بدون to می‌آید."},{"text":"down stair","ok":false,"why":"یک کلمه، با s: downstairs."}]},{"type":"produce","id":"p1","prompt":"بچه‌ها پایین هستند.","frame":"The children are ___.","answer":"downstairs","accept":[],"why":"be downstairs."}]}],"version":"ffe2ebdc2014","order":731,"released":false},{"id":"lex:A1:east","headword":"east","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:east","pos":"noun","gloss":"شرق","meaning":"جهتِ شرق، جایی که خورشید طلوع می‌کند. in the east of = در شرقِ …. به‌صورت صفت و قید هم: the east side، go east.","grammar":[{"pattern":"in the east (of)","note":"در شرق"},{"pattern":"east of + place","note":"شرقِ جایی"},{"pattern":"go / travel east","note":"به سمت شرق رفتن"}],"examples":[{"en":"The sun comes up in the east.","fa":"خورشید از شرق طلوع می‌کند."},{"en":"We drove east for two hours.","fa":"دو ساعت به سمت شرق رانندگی کردیم."}],"collocations":["in the east","the east of","go east","east and west"],"mistake":{"wrong":"We live in east of the city.","right":"We live in the east of the city.","why":"قبل از east، the لازم است."},"pronunciation":{"gb":"/iːst/","us":"/iːst/"},"check":[{"type":"cloze","id":"c1","text":"The opposite of west is ___.","answer":"east","accept":[],"fa":"ضدِ غرب شرق است.","why":"east ↔ west."},{"type":"choice","id":"q1","prompt":"The sun goes down in the west and comes up in the ___.","options":[{"text":"east","ok":true,"why":"خورشید از شرق طلوع می‌کند."},{"text":"north","ok":false,"why":"خورشید از شمال طلوع نمی‌کند."},{"text":"south","ok":false,"why":"خورشید از جنوب طلوع نمی‌کند."}]},{"type":"produce","id":"p1","prompt":"خانه‌شان در شرقِ شهر است.","frame":"Their house is in the ___ of the town.","answer":"east","accept":[],"why":"in the east of."}]}],"version":"2f40bdcbb30a","order":732,"released":false},{"id":"lex:A1:eighteen","headword":"eighteen","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:eighteen","pos":"number","gloss":"هجده","meaning":"عدد ۱۸. تکیه روی بخش دوم است: eigh-TEEN. eighty یعنی ۸۰. فقط یک t دارد.","grammar":[{"pattern":"eighteen + plural noun","note":"eighteen days"},{"pattern":"eighteen years old","note":"هجده‌ساله"},{"pattern":"eighteen / eighty","note":"۱۸ / ۸۰"}],"examples":[{"en":"My brother is eighteen.","fa":"برادرم هجده سال دارد."},{"en":"There are eighteen students in the class.","fa":"در کلاس هجده دانش‌آموز هست."}],"collocations":["eighteen years old","eighteen months","at eighteen","eighteen people"],"mistake":{"wrong":"He is eightteen.","right":"He is eighteen.","why":"eighteen فقط یک t دارد."},"pronunciation":{"gb":"/ˌeɪˈtiːn/","us":"/ˌeɪˈtiːn/"},"check":[{"type":"cloze","id":"c1","text":"Nine and nine make ___.","answer":"eighteen","accept":["18"],"fa":"نه و نه می‌شود هجده.","why":"۹ + ۹ = ۱۸."},{"type":"choice","id":"q1","prompt":"How do you write 18 in words?","options":[{"text":"eighteen","ok":true,"why":"۱۸ = eighteen."},{"text":"eighty","ok":false,"why":"eighty = ۸۰."},{"text":"eightteen","ok":false,"why":"eighteen فقط یک t دارد."}]},{"type":"produce","id":"p1","prompt":"هجده سالم است.","frame":"I'm ___ years old.","answer":"eighteen","accept":["18"],"why":"eighteen = هجده."}]}],"version":"57f32825dec7","order":733,"released":false},{"id":"lex:A1:euro","headword":"euro","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:euro","pos":"noun","gloss":"یورو","meaning":"پولِ بیشترِ کشورهای اروپا (€). جمعش معمولاً euros است (گاهی euro هم می‌گویند). با صدای «یو» شروع می‌شود، پس a euro.","grammar":[{"pattern":"number + euros","note":"ten euros"},{"pattern":"in euros","note":"به یورو"},{"pattern":"a euro","note":"با a، نه an"}],"examples":[{"en":"This bag costs twenty euros.","fa":"این کیف بیست یورو قیمت دارد."},{"en":"Can I pay in euros?","fa":"می‌توانم به یورو پرداخت کنم؟"}],"collocations":["ten euros","pay in euros","a euro coin","a hundred euros"],"mistake":{"wrong":"It costs an euro.","right":"It costs a euro.","why":"euro با صدای «یو» شروع می‌شود: a euro."},"pronunciation":{"gb":"/ˈjʊərəʊ/","us":"/ˈjʊroʊ/"},"check":[{"type":"cloze","id":"c1","text":"In France and Spain, people pay in ___.","answer":"euros","accept":["euro"],"fa":"در فرانسه و اسپانیا مردم با یورو پرداخت می‌کنند.","why":"pay in euros."},{"type":"choice","id":"q1","prompt":"I found ___ euro on the floor.","options":[{"text":"a","ok":true,"why":"صدای «یو»: a euro."},{"text":"an","ok":false,"why":"euro با صدای «یو» شروع می‌شود."},{"text":"much","ok":false,"why":"euro قابل‌شمارش است؛ much با آن نمی‌آید."}]},{"type":"produce","id":"p1","prompt":"پنجاه یورو لازم دارم.","frame":"I need fifty ___.","answer":"euros","accept":["euro"],"why":"fifty euros."}]}],"version":"26d0988aa983","order":734,"released":false},{"id":"lex:A1:ever","headword":"ever","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:ever","pos":"adverb","gloss":"تا به حال؛ هیچ‌وقت","meaning":"در سؤال: Have you ever …? = تا حالا …؟ معمولاً با have + اسم مفعول. the best … ever = بهترین … تا حالا.","grammar":[{"pattern":"Have you ever + past participle?","note":"تا حالا …؟"},{"pattern":"never / ever","note":"never منفی است؛ ever در سؤال"},{"pattern":"the best … I have ever …","note":"بهترین … که تا حالا …"}],"examples":[{"en":"Have you ever been to the sea?","fa":"تا حالا دریا رفته‌ای؟"},{"en":"This is the best film I have ever seen.","fa":"این بهترین فیلمی است که تا حالا دیده‌ام."}],"collocations":["have you ever","the best ever","if you ever","ever since"],"mistake":{"wrong":"Did you ever been to Paris?","right":"Have you ever been to Paris?","why"