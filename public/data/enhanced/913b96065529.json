{"entries":[{"id":"lex:A1:time","headword":"time","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:time","pos":"noun","gloss":"زمان؛ وقت","meaning":"زمانی که می‌گذرد یا برای کاری لازم است. در این معنا غیرقابل‌شمارش است: I don't have time. همچنین برای ساعت: What time is it?","grammar":[{"pattern":"time is uncountable","note":"I don't have much time. (نه many times)"},{"pattern":"What time …?","note":"What time is it? / What time does it start?"},{"pattern":"time to + verb","note":"It's time to go."}],"examples":[{"en":"What time is it?","fa":"ساعت چند است؟"},{"en":"Sorry, I don't have time today.","fa":"ببخشید، امروز وقت ندارم."}],"collocations":["on time","free time","a long time","it's time to"],"mistake":{"wrong":"I don't have many times.","right":"I don't have much time.","why":"time در معنای «وقت» غیرقابل‌شمارش است: much time."},"pronunciation":{"gb":"/taɪm/","us":"/taɪm/"},"check":[{"type":"cloze","id":"c1","text":"Hurry up! It's ___ to leave.","answer":"time","accept":[],"fa":"عجله کن! وقت رفتن است.","why":"it's time to + فعل."},{"type":"choice","id":"q1","prompt":"The train always arrives ___ time.","options":[{"text":"on","ok":true,"why":"on time = سر وقت."},{"text":"in","ok":false,"why":"in time یعنی «به موقع، پیش از دیر شدن» و معنای کمی دیگری دارد."},{"text":"at","ok":false,"why":"at time نادرست است."}]},{"type":"produce","id":"p1","prompt":"در وقت آزادم کتاب می‌خوانم.","frame":"I read books in my free ___.","answer":"time","accept":[],"why":"free time."}]},{"id":"lex:A1:time#occasion","pos":"noun","gloss":"بار؛ دفعه","meaning":"تعداد دفعه‌های انجام کاری. در این معنا قابل‌شمارش است: one time, three times. برای یک و دو بار معمولاً once و twice می‌گوییم.","grammar":[{"pattern":"number + times","note":"three times a week"},{"pattern":"the first / last time","note":"This is my first time in Mashhad."}],"examples":[{"en":"I go swimming three times a week.","fa":"هفته‌ای سه بار شنا می‌روم."},{"en":"This is my first time in London.","fa":"این اولین بار است که به لندن می‌آیم."}],"collocations":["three times","the first time","every time","next time"],"mistake":{"wrong":"I saw him two times.","right":"I saw him twice.","why":"two times غلط نیست، اما twice طبیعی‌تر است."},"pronunciation":{"gb":"/taɪm/","us":"/taɪm/"},"check":[{"type":"cloze","id":"c1","text":"I have English class four ___ a week.","answer":"times","accept":[],"fa":"هفته‌ای چهار بار کلاس انگلیسی دارم.","why":"تعداد دفعه‌ها: times."},{"type":"produce","id":"p1","prompt":"دفعهٔ بعد با تو می‌آیم.","frame":"Next ___, I'll come with you.","answer":"time","accept":[],"why":"next time = دفعهٔ بعد."},{"type":"produce","id":"h1","prompt":"یک بار دیگر امتحان کنیم.","frame":"Let's try one more ___.","answer":"time","accept":[],"why":"one more time = یک بار دیگر."}]}],"version":"f6cd4a85ae9b","order":100,"unit":2,"prerequisites":["lex:A1:what","lex:A1:be"],"released":false},{"id":"lex:A1:day","headword":"day","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:day","pos":"noun","gloss":"روز","meaning":"مدت بیست‌وچهار ساعت، یا بخش روشنِ آن (در برابر شب).","grammar":[{"pattern":"on + day (of the week)","note":"on Monday, on that day"},{"pattern":"every day / all day / one day","note":"بدون حرف اضافه"}],"examples":[{"en":"I work eight hours a day.","fa":"روزی هشت ساعت کار می‌کنم."},{"en":"Have a nice day!","fa":"روز خوبی داشته باشی!"}],"collocations":["every day","all day","one day","the next day"],"mistake":{"wrong":"I study in every day.","right":"I study every day.","why":"پیش از every day حرف اضافه نمی‌آید."},"pronunciation":{"gb":"/deɪ/","us":"/deɪ/"},"check":[{"type":"cloze","id":"c1","text":"We walk for thirty minutes every ___.","answer":"day","accept":[],"fa":"هر روز سی دقیقه پیاده‌روی می‌کنیم.","why":"every day."},{"type":"choice","id":"q1","prompt":"She was ill, so she stayed in bed ___.","options":[{"text":"all day","ok":true,"why":"all day = تمام روز."},{"text":"in all day","ok":false,"why":"حرف اضافه لازم نیست."},{"text":"all days","ok":false,"why":"all day مفرد است."}]},{"type":"produce","id":"p1","prompt":"روز خوبی داشته باشید!","frame":"Have a nice ___!","answer":"day","accept":[],"why":"عبارت خداحافظی."}]}],"version":"71c8133a18cd","order":101,"unit":2,"prerequisites":[],"released":false},{"id":"lex:A1:morning","headword":"morning","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:morning","pos":"noun","gloss":"صبح","meaning":"بخش اول روز، از بیدار شدن تا ظهر.","grammar":[{"pattern":"in the morning","note":"I study in the morning."},{"pattern":"on + day + morning","note":"on Monday morning"},{"pattern":"this / tomorrow / yesterday morning","note":"بدون حرف اضافه"}],"examples":[{"en":"I drink coffee every morning.","fa":"هر روز صبح قهوه می‌خورم."},{"en":"Good morning, everyone!","fa":"صبح همگی بخیر!"}],"collocations":["good morning","in the morning","this morning"],"mistake":{"wrong":"I go to work at the morning.","right":"I go to work in the morning.","why":"با morning حرف اضافهٔ in می‌آید (اما at night)."},"pronunciation":{"gb":"/ˈmɔːnɪŋ/","us":"/ˈmɔːrnɪŋ/"},"check":[{"type":"cloze","id":"c1","text":"I always have a shower in the ___.","answer":"morning","accept":[],"fa":"همیشه صبح دوش می‌گیرم.","why":"in the morning."},{"type":"choice","id":"q1","prompt":"The meeting is ___ Tuesday morning.","options":[{"text":"on","ok":true,"why":"روز مشخص + morning: on."},{"text":"in","ok":false,"why":"وقتی روز ذکر شده، on می‌آید."},{"text":"at","ok":false,"why":"at برای ساعت است."}]},{"type":"produce","id":"p1","prompt":"صبح بخیر!","frame":"Good ___!","answer":"morning","accept":[],"why":"سلامِ صبحگاهی."}]}],"version":"2bf8d4d3cb35","order":102,"unit":2,"prerequisites":["lex:A1:day","lex:A1:in"],"released":false},{"id":"lex:A1:afternoon","headword":"afternoon","goals":["everyday","general"],"senses":[{"id":"lex:A1:afternoon","pos":"noun","gloss":"بعدازظهر","meaning":"زمانِ بین ظهر و عصر. in the afternoon، ولی on + روز + afternoon (on Monday afternoon). Good afternoon = سلام (بعدازظهر).","grammar":[{"pattern":"in the afternoon","note":"بعدازظهر"},{"pattern":"on + day + afternoon","note":"on Monday afternoon"},{"pattern":"this / tomorrow afternoon","note":"بدون حرف اضافه"}],"examples":[{"en":"I usually sleep for an hour in the afternoon.","fa":"معمولاً بعدازظهر یک ساعت می‌خوابم."},{"en":"See you on Friday afternoon.","fa":"جمعه بعدازظهر می‌بینمت."}],"collocations":["in the afternoon","this afternoon","Good afternoon","on Sunday afternoon"],"mistake":{"wrong":"I'll see you in Friday afternoon.","right":"I'll see you on Friday afternoon.","why":"با روزِ هفته on می‌آید."},"pronunciation":{"gb":"/ˌɑːftəˈnuːn/","us":"/ˌæftɚˈnuːn/","note":"تکیهٔ اصلی روی «نون» است: «آفتِرنون»."},"tts":{"gb":"ˌɑːftənˈuːn"},"check":[{"type":"cloze","id":"c1","text":"The shop closes at two in the ___ on Fridays.","answer":"afternoon","accept":[],"fa":"مغازه جمعه‌ها ساعت دو بعدازظهر می‌بندد.","why":"in the afternoon."},{"type":"choice","id":"q1","prompt":"I have a meeting ___ Tuesday afternoon.","options":[{"text":"on","ok":true,"why":"با روزِ هفته on می‌آید."},{"text":"in","ok":false,"why":"با روزِ هفته in نمی‌آید."},{"text":"at","ok":false,"why":"at Tuesday afternoon غلط است."}]},{"type":"produce","id":"p1","prompt":"امروز بعدازظهر چه کار می‌کنی؟","frame":"What are you doing this ___?","answer":"afternoon","accept":[],"why":"this afternoon، بدون حرف اضافه."}]}],"version":"257e10f63d35","order":103,"unit":2,"prerequisites":["lex:A1:day","lex:A1:in"],"released":false},{"id":"lex:A1:evening","headword":"evening","goals":["everyday","general"],"senses":[{"id":"lex:A1:evening","pos":"noun","gloss":"عصر؛ سرِ شب","meaning":"زمانِ بعد از بعدازظهر تا وقت خواب. in the evening؛ با روز on: on Friday evening. Good evening برای سلام است، Good night برای خداحافظی و خواب.","grammar":[{"pattern":"in the evening","note":"عصرها"},{"pattern":"on + day + evening","note":"on Monday evening"},{"pattern":"this / tomorrow evening","note":"بدون حرف اضافه"}],"examples":[{"en":"I'm free on Thursday evening.","fa":"پنجشنبه عصر آزادم."},{"en":"The shop is open until nine in the evening.","fa":"مغازه تا ساعت نه شب باز است."}],"collocations":["in the evening","this evening","Good evening","on Friday evening"],"mistake":{"wrong":"Good night, how are you?","right":"Good evening, how are you?","why":"Good night برای خداحافظی و وقت خواب است؛ برای سلام Good evening."},"pronunciation":{"gb":"/ˈiːvnɪŋ/","us":"/ˈiːvnɪŋ/","note":"دو بخشی خوانده می‌شود: «ایونینگ»."},"check":[{"type":"cloze","id":"c1","text":"We have dinner at eight in the ___.","answer":"evening","accept":[],"fa":"ساعت هشت شب شام می‌خوریم.","why":"in the evening."},{"type":"choice","id":"q1","prompt":"See you ___ Saturday evening.","options":[{"text":"on","ok":true,"why":"با روزِ هفته on می‌آید."},{"text":"in","ok":false,"why":"با روزِ هفته in نمی‌آید."},{"text":"at","ok":false,"why":"at Saturday evening غلط است."}]},{"type":"produce","id":"p1","prompt":"عصر به خیر!","frame":"Good ___!","answer":"evening","accept":[],"why":"Good evening برای سلام."}]}],"version":"5aaf2919f8e9","order":104,"unit":2,"prerequisites":["lex:A1:day","lex:A1:in"],"released":false},{"id":"lex:A1:night","headword":"night","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:night","pos":"noun","gloss":"شب","meaning":"زمانِ تاریکِ بین غروب و صبح، به‌ویژه زمان خواب.","grammar":[{"pattern":"at night","note":"I can't sleep at night. (نه in the night در معنای کلی)"},{"pattern":"last night / tonight","note":"دیشب / امشب"}],"examples":[{"en":"I work at night.","fa":"شب‌ها کار می‌کنم."},{"en":"Good night! Sleep well.","fa":"شب بخیر! خوب بخوابی."}],"collocations":["at night","last night","good night","all night"],"mistake":{"wrong":"Good night! (when you meet someone in the evening)","right":"Good evening!","why":"Good night فقط برای خداحافظی یا پیش از خواب است؛ برای سلام شبانه Good evening."},"pronunciation":{"gb":"/naɪt/","us":"/naɪt/","note":"gh خوانده نمی‌شود."},"check":[{"type":"cloze","id":"c1","text":"Owls sleep in the day and fly at ___.","answer":"night","accept":[],"fa":"جغدها روز می‌خوابند و شب پرواز می‌کنند.","why":"at night."},{"type":"choice","id":"q1","prompt":"You arrive at a party at 8 p.m. You say: ___","options":[{"text":"Good evening!","ok":true,"why":"سلام شبانه."},{"text":"Good night!","ok":false,"why":"برای خداحافظی است."},{"text":"Good day!","ok":false,"why":"در انگلیسی امروزی رایج نیست."}]},{"type":"produce","id":"p1","prompt":"دیشب خوب نخوابیدم.","frame":"I didn't sleep well last ___.","answer":"night","accept":[],"why":"last night."}]}],"version":"7e23476b8abd","order":105,"unit":2,"prerequisites":["lex:A1:day"],"released":false},{"id":"lex:A1:today","headword":"today","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:today","pos":"adverb","gloss":"امروز","meaning":"روزی که در آن هستیم. پیش از آن حرف اضافه نمی‌آید.","grammar":[{"pattern":"today (no preposition)","note":"I'm busy today. (نه in today)"},{"pattern":"today's + noun","note":"today's newspaper"}],"examples":[{"en":"What day is it today?","fa":"امروز چه روزی است؟"},{"en":"I'm working from home today.","fa":"امروز از خانه کار می‌کنم."}],"collocations":["today's","later today","from today"],"mistake":{"wrong":"I have a test in today.","right":"I have a test today.","why":"پیش از today حرف اضافه نمی‌آید."},"pronunciation":{"gb":"/təˈdeɪ/","us":"/təˈdeɪ/","note":"تأکید روی بخش دوم: to-DAY."},"check":[{"type":"cloze","id":"c1","text":"It's very sunny ___. Let's go to the park.","answer":"today","accept":[],"fa":"امروز هوا خیلی آفتابی است. بیا به پارک برویم.","why":"امروز، بدون حرف اضافه."},{"type":"choice","id":"q1","prompt":"Choose the correct sentence.","options":[{"text":"I can't come today.","ok":true,"why":"today بدون حرف اضافه."},{"text":"I can't come in today.","ok":false,"why":"in لازم نیست."},{"text":"I can't come at today.","ok":false,"why":"at لازم نیست."}]},{"type":"produce","id":"p1","prompt":"امروز چندم است؟","frame":"What's the date ___?","answer":"today","accept":[],"why":"today."}]}],"version":"f712548c6374","order":106,"unit":2,"prerequisites":["lex:A1:day","lex:A1:be"],"released":false},{"id":"lex:A1:every","headword":"every","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:every","pos":"determiner","gloss":"هر","meaning":"تک‌تکِ افراد یا چیزهای یک گروه، بدون استثنا. همیشه با اسم مفرد و فعل مفرد می‌آید (every student has). برای تکرار در زمان: every day = هر روز.","grammar":[{"pattern":"every + singular noun + singular verb","note":"Every room has a bathroom."},{"pattern":"every + time word","note":"every day, every week, every morning"},{"pattern":"every + number + time","note":"every two hours = هر دو ساعت یک بار"}],"examples":[{"en":"Every student has a book.","fa":"هر دانش‌آموز یک کتاب دارد."},{"en":"I call my mother every evening.","fa":"هر شب به مادرم زنگ می‌زنم."}],"collocations":["every day","every week","every year","every time"],"mistake":{"wrong":"Every students are here.","right":"Every student is here.","why":"بعد از every اسم مفرد و فعل مفرد می‌آید، هرچند معنایش «همه» است."},"pronunciation":{"gb":"/ˈevri/","us":"/ˈevri/","note":"معمولاً دوبخشی خوانده می‌شود: «اِوری»."},"check":[{"type":"cloze","id":"c1","text":"The bus comes ___ ten minutes.","answer":"every","accept":[],"fa":"اتوبوس هر ده دقیقه می‌آید.","why":"every + عدد + زمان = هر … یک بار."},{"type":"choice","id":"q1","prompt":"Every child ___ a present.","options":[{"text":"gets","ok":true,"why":"بعد از every فعل مفرد می‌آید."},{"text":"get","ok":false,"why":"فاعل مفرد است و فعل s می‌گیرد."},{"text":"are get","ok":false,"why":"این ساختار فعل غلط است."}]},{"type":"produce","id":"p1","prompt":"هر صبح ورزش می‌کنم.","frame":"I exercise ___ morning.","answer":"every","accept":[],"why":"every morning = هر صبح."}]}],"version":"853217879b4d","order":107,"unit":2,"prerequisites":["lex:A1:day"],"released":false},{"id":"lex:A1:always","headword":"always","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:always","pos":"adverb","gloss":"همیشه","meaning":"در همهٔ مواقع. جایش قبل از فعل اصلی است، ولی بعد از am / is / are: I always walk / I am always late.","grammar":[{"pattern":"always + main verb","note":"I always get up at seven."},{"pattern":"be + always","note":"She is always happy."},{"pattern":"not always","note":"همیشه نه؛ گاهی"}],"examples":[{"en":"I always have breakfast at home.","fa":"من همیشه صبحانه را در خانه می‌خورم."},{"en":"My brother is always late.","fa":"برادرم همیشه دیر می‌کند."}],"collocations":["always late","not always","as always","always remember"],"mistake":{"wrong":"I go always to school by bus.","right":"I always go to school by bus.","why":"always قبل از فعل اصلی می‌آید، نه بعد از آن."},"pronunciation":{"gb":"/ˈɔːlweɪz/","us":"/ˈɔːlweɪz/","note":"تکیه روی بخش اول است: «اُلوِیز»."},"check":[{"type":"cloze","id":"c1","text":"I ___ wash my face before bed. Every night!","answer":"always","accept":[],"fa":"من همیشه قبل از خواب صورتم را می‌شویم. هر شب!","why":"هر شب = همیشه."},{"type":"choice","id":"q1","prompt":"I ___ late for school. I'm never on time!","options":[{"text":"am always","ok":true,"why":"always بعد از am می‌آید."},{"text":"always","ok":false,"why":"فعل am جا افتاده است."},{"text":"am never","ok":false,"why":"با «هیچ‌وقت سر وقت نیستم» جور نیست."}]},{"type":"produce","id":"p1","prompt":"من همیشه پیاده سر کار می‌روم.","frame":"I ___ walk to work.","answer":"always","accept":[],"why":"always قبل از فعل اصلی."}]}],"version":"0ed9ad44a989","order":108,"unit":2,"prerequisites":["lex:A1:be"],"released":false},{"id":"lex:A1:usually","headword":"usually","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:usually","pos":"adverb","gloss":"معمولاً","meaning":"در بیشتر مواقع. جایش مثل always است: قبل از فعل اصلی، بعد از am / is / are.","grammar":[{"pattern":"usually + main verb","note":"I usually walk."},{"pattern":"be + usually","note":"He's usually late."},{"pattern":"Usually, …","note":"اول جمله هم می‌آید."}],"examples":[{"en":"I usually have tea for breakfast.","fa":"صبحانه معمولاً چای می‌خورم."},{"en":"The bus is usually on time.","fa":"اتوبوس معمولاً سر وقت می‌آید."}],"collocations":["usually go","not usually","usually late","usually on time"],"mistake":{"wrong":"I go usually to bed at ten.","right":"I usually go to bed at ten.","why":"usually قبل از فعل اصلی می‌آید."},"pronunciation":{"gb":"/ˈjuːʒuəli/","us":"/ˈjuːʒuəli/","note":"s مثل «ژ»: «یوژوآلی»."},"check":[{"type":"cloze","id":"c1","text":"On Fridays we ___ visit our grandparents.","answer":"usually","accept":["always","often","sometimes"],"fa":"جمعه‌ها معمولاً به دیدن پدربزرگ و مادربزرگمان می‌رویم.","why":"usually قبل از فعل اصلی."},{"type":"choice","id":"q1","prompt":"I ___ get up at seven, but today I got up at nine.","options":[{"text":"usually","ok":true,"why":"usually قید است و قبل از فعل می‌آید."},{"text":"usual","ok":false,"why":"usual صفت است؛ قبل از فعل قید لازم است."},{"text":"use","ok":false,"why":"use فعل است، نه قید."}]},{"type":"produce","id":"p1","prompt":"معمولاً ساعت هفت شام می‌خوریم.","frame":"We ___ have dinner at seven.","answer":"usually","accept":[],"why":"usually قبل از فعل اصلی."}]}],"version":"9b2a91f633ca","order":109,"unit":2,"prerequisites":["lex:A1:be"],"released":false},{"id":"lex:A1:sometimes","headword":"sometimes","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:sometimes","pos":"adverb","gloss":"گاهی","meaning":"بعضی وقت‌ها، نه همیشه. معمولاً قبل از فعلِ اصلی، یا اول یا آخر جمله. sometime (یک وقتی) و some time (مقداری وقت) فرق دارند.","grammar":[{"pattern":"sometimes + verb","note":"I sometimes walk."},{"pattern":"Sometimes, …","note":"اول جمله"},{"pattern":"sometimes / sometime","note":"گاهی / یک وقتی"}],"examples":[{"en":"I sometimes walk to work.","fa":"گاهی پیاده سر کار می‌روم."},{"en":"Sometimes it snows in March.","fa":"گاهی در مارس برف می‌بارد."}],"collocations":["sometimes late","only sometimes","sometimes … sometimes","and sometimes"],"mistake":{"wrong":"I go sometimes to 