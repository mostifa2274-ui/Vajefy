{"entries":[{"id":"lex:A1:quick","headword":"quick","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:quick","pos":"adjective","gloss":"سریع؛ کوتاه","meaning":"چیزی که زمان کمی می‌گیرد (a quick question)، یا کسی که سریع کار می‌کند. قیدش quickly است.","grammar":[{"pattern":"a quick + noun","note":"a quick question, a quick lunch"},{"pattern":"quick / quickly","note":"صفت / قید"},{"pattern":"Be quick!","note":"عجله کن!"}],"examples":[{"en":"Can I ask you a quick question?","fa":"می‌توانم یک سؤال کوتاه بپرسم؟"},{"en":"We had a quick lunch and went back to work.","fa":"یک ناهار سریع خوردیم و برگشتیم سر کار."}],"collocations":["a quick question","a quick look","be quick","a quick lunch"],"mistake":{"wrong":"I have a question quick.","right":"I have a quick question.","why":"صفت قبل از اسم می‌آید."},"pronunciation":{"gb":"/kwɪk/","us":"/kwɪk/"},"check":[{"type":"cloze","id":"c1","text":"I'm just going out for a ___ walk. I'll be back in ten minutes.","answer":"quick","accept":["short"],"fa":"فقط برای یک پیاده‌روی کوتاه بیرون می‌روم. ده دقیقه دیگر برمی‌گردم.","why":"a quick walk."},{"type":"choice","id":"q1","prompt":"Be ___! The bus is leaving.","options":[{"text":"quick","ok":true,"why":"بعد از be صفت می‌آید."},{"text":"quickly","ok":false,"why":"quickly قید است."},{"text":"quickness","ok":false,"why":"quickness اسم است."}]},{"type":"produce","id":"p1","prompt":"یک نگاه سریع بینداز.","frame":"Have a ___ look.","answer":"quick","accept":[],"why":"a quick look."}]}],"version":"8fc35dc5d056","order":475,"unit":6,"prerequisites":["lex:A1:travel","lex:A1:fast"],"released":false},{"id":"lex:A1:quickly","headword":"quickly","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:quickly","pos":"adverb","gloss":"به‌سرعت؛ تند","meaning":"با سرعت زیاد یا در زمان کم. قید است و فعل را توصیف می‌کند (walk quickly). صفتش quick است.","grammar":[{"pattern":"verb + quickly","note":"walk quickly, eat quickly, finish quickly"},{"pattern":"quick / quickly","note":"a quick lunch (صفت) / eat quickly (قید)"}],"examples":[{"en":"She walks quickly to school.","fa":"او تند به مدرسه می‌رود."},{"en":"Please come quickly! Something is wrong.","fa":"لطفاً زود بیا! یک مشکلی هست."}],"collocations":["walk quickly","very quickly","learn quickly","as quickly as possible"],"mistake":{"wrong":"He runs very quick.","right":"He runs very quickly.","why":"برای توصیف فعل قید quickly لازم است؛ quick صفت است."},"pronunciation":{"gb":"/ˈkwɪkli/","us":"/ˈkwɪkli/"},"check":[{"type":"cloze","id":"c1","text":"The children ate their lunch very ___ and ran outside.","answer":"quickly","accept":[],"fa":"بچه‌ها ناهارشان را خیلی تند خوردند و به بیرون دویدند.","why":"قید برای فعل eat."},{"type":"choice","id":"q1","prompt":"She finished her homework ___.","options":[{"text":"quickly","ok":true,"why":"قید برای فعل."},{"text":"quick","ok":false,"why":"quick صفت است."},{"text":"fastly","ok":false,"why":"fastly کلمه نیست؛ fast خودش قید است."}]},{"type":"produce","id":"p1","prompt":"لطفاً تند راه برو، دیرمان شده.","frame":"Please walk ___. We're late.","answer":"quickly","accept":["fast"],"why":"walk quickly."}]}],"version":"e6678c87065f","order":476,"unit":6,"prerequisites":["lex:A1:travel","lex:A1:fast"],"released":false},{"id":"lex:A1:ready","headword":"ready","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:ready","pos":"adjective","gloss":"آماده","meaning":"برای کاری آمادگی داشتن، یا تمام‌شده و قابل استفاده بودن. ready for + اسم؛ ready to + فعل. get ready = آماده شدن.","grammar":[{"pattern":"ready for + noun","note":"ready for school"},{"pattern":"ready to + verb","note":"ready to go"},{"pattern":"get ready","note":"آماده شدن"}],"examples":[{"en":"Dinner is ready!","fa":"شام آماده است!"},{"en":"Are you ready to go?","fa":"آماده‌ای برویم؟"}],"collocations":["get ready","ready for","ready to go","almost ready"],"mistake":{"wrong":"I'm ready for go.","right":"I'm ready to go.","why":"قبل از فعل to می‌آید: ready to go."},"pronunciation":{"gb":"/ˈredi/","us":"/ˈredi/","note":"ea مثل «اِ»: «رِدی»."},"check":[{"type":"cloze","id":"c1","text":"Wait a minute. I'm not ___ yet.","answer":"ready","accept":[],"fa":"یک لحظه صبر کن. هنوز آماده نیستم.","why":"ready = آماده."},{"type":"choice","id":"q1","prompt":"Get ___ for school. The bus is coming!","options":[{"text":"ready","ok":true,"why":"get ready = آماده شدن."},{"text":"readily","ok":false,"why":"readily قید است."},{"text":"already","ok":false,"why":"already یعنی «قبلاً» یا «تا حالا»."}]},{"type":"produce","id":"p1","prompt":"صبحانه آماده است.","frame":"Breakfast is ___.","answer":"ready","accept":[],"why":"ready = آماده."}]}],"version":"6731d182fde2","order":477,"unit":6,"prerequisites":["lex:A1:travel","lex:A1:trip"],"released":false},{"id":"lex:A1:through","headword":"through","goals":["everyday","general"],"senses":[{"id":"lex:A1:through","pos":"preposition","gloss":"از میانِ؛ از داخلِ","meaning":"حرکت از یک طرف چیزی به طرف دیگرش، از داخل آن: through the park، through the door. برای جاهایی که دور و بر ما را گرفته‌اند (پارک، شهر، جنگل).","grammar":[{"pattern":"go / walk + through + place","note":"walk through the park, drive through the city"},{"pattern":"look through + window","note":"از پنجره نگاه کردن"}],"examples":[{"en":"We walk through the park.","fa":"از میان پارک رد می‌شویم."},{"en":"The train goes through the mountains.","fa":"قطار از میان کوه‌ها می‌گذرد."}],"collocations":["through the park","through the door","through the window","through the city"],"mistake":{"wrong":"We walked from the park to get home.","right":"We walked through the park to get home.","why":"برای عبور از داخل یک جا through می‌گوییم؛ from فقط نقطهٔ شروع را نشان می‌دهد."},"pronunciation":{"gb":"/θruː/","us":"/θruː/","note":"th مثل «ث» است؛ با threw هم‌صداست."},"check":[{"type":"cloze","id":"c1","text":"The cat came in ___ the window.","answer":"through","accept":[],"fa":"گربه از پنجره داخل آمد.","why":"from one side to the other: through."},{"type":"choice","id":"q1","prompt":"We drove ___ the city to get to the airport.","options":[{"text":"through","ok":true,"why":"عبور از داخل شهر."},{"text":"from","ok":false,"why":"from فقط نقطهٔ شروع است."},{"text":"into","ok":false,"why":"into یعنی به داخل، نه عبور."}]},{"type":"produce","id":"p1","prompt":"از پنجره نگاه کردم.","frame":"I looked ___ the window.","answer":"through","accept":["out of"],"why":"look through the window."}]}],"version":"93f0a7133905","order":478,"unit":6,"prerequisites":["lex:A1:travel","lex:A1:place"],"released":false},{"id":"lex:A1:until","headword":"until","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:until","pos":"preposition","gloss":"تا (زمانِ)","meaning":"تا یک زمان، و بعد از آن نه: until five = تا ساعت پنج. با جمله هم می‌آید: Wait until I come. بعد از until برای آینده، حال ساده می‌آید.","grammar":[{"pattern":"until + time","note":"until Friday"},{"pattern":"until + clause (present)","note":"Wait until I come back."},{"pattern":"not … until","note":"The shop doesn't open until ten."}],"examples":[{"en":"The shop is open until nine.","fa":"مغازه تا ساعت نه باز است."},{"en":"Wait here until I come back.","fa":"تا برگردم همین‌جا منتظر بمان."}],"collocations":["until now","until tomorrow","until late","wait until"],"mistake":{"wrong":"Wait until I will come back.","right":"Wait until I come back.","why":"بعد از until برای آینده، حال ساده می‌آید."},"pronunciation":{"gb":"/ənˈtɪl/","us":"/ənˈtɪl/","note":"تکیه روی بخش دوم است: «اِنتیل»."},"check":[{"type":"cloze","id":"c1","text":"I work from nine ___ five.","answer":"until","accept":["to","till"],"fa":"از نه تا پنج کار می‌کنم.","why":"from … until …"},{"type":"choice","id":"q1","prompt":"Stay in bed ___ you feel better.","options":[{"text":"until","ok":true,"why":"until = تا وقتی که."},{"text":"by","ok":false,"why":"by + جمله اینجا غلط است."},{"text":"for","ok":false,"why":"for + جمله اینجا غلط است."}]},{"type":"produce","id":"p1","prompt":"تا فردا صبر کن.","frame":"Wait ___ tomorrow.","answer":"until","accept":["till"],"why":"until + زمان."}]}],"version":"014283f990bf","order":479,"unit":6,"prerequisites":["lex:A1:time","lex:A1:travel"],"released":false},{"id":"lex:A1:when","headword":"when","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:when","pos":"adverb","gloss":"کی؛ وقتی که","meaning":"برای پرسیدن دربارهٔ زمان، یا «وقتی که» برای وصل کردن دو اتفاق.","grammar":[{"pattern":"When + do/does/did + subject + verb?","note":"When does the shop open?"},{"pattern":"when + present for the future","note":"When I get home, I'll call you. (بعد از when برای آینده، حال ساده)"}],"examples":[{"en":"When is your birthday?","fa":"تولدت کی است؟"},{"en":"I was tired when I got home.","fa":"وقتی به خانه رسیدم خسته بودم."}],"collocations":["since when","when I was a child","say when"],"mistake":{"wrong":"When I will finish, I'll call you.","right":"When I finish, I'll call you.","why":"مثل if، بعد از when برای آینده از حال ساده استفاده می‌کنیم."},"pronunciation":{"gb":"/wen/","us":"/wen/"},"check":[{"type":"cloze","id":"c1","text":"___ does your class start?","answer":"When","accept":["when"],"fa":"کلاست کی شروع می‌شود؟","why":"پرسیدن زمان."},{"type":"choice","id":"q1","prompt":"Call me when you ___ the station.","options":[{"text":"get to","ok":true,"why":"بعد از when برای آینده، حال ساده."},{"text":"will get to","ok":false,"why":"will بعد از when نمی‌آید."},{"text":"got to","ok":false,"why":"گذشته است، اما منظور آینده است."}]},{"type":"produce","id":"p1","prompt":"وقتی بچه بودم، در شیراز زندگی می‌کردم.","frame":"___ I was a child, I lived in Shiraz.","answer":"When","accept":[],"why":"when دو بخش جمله را از نظر زمانی وصل می‌کند.","support":[{"en":"Shiraz","fa":"شیراز"}]}]}],"version":"9fe41c46648b","order":480,"unit":6,"prerequisites":["lex:A1:time","lex:A1:travel"],"released":false},{"id":"lex:A1:will","headword":"will","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:will","pos":"modal","gloss":"(فعل کمکی آینده)","meani