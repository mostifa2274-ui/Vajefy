{"entries":[{"id":"lex:A1:hat","headword":"hat","goals":["everyday","general"],"senses":[{"id":"lex:A1:hat","pos":"noun","gloss":"کلاه","meaning":"چیزی که روی سر می‌گذاریم. wear a hat = کلاه گذاشتن؛ put on / take off your hat.","grammar":[{"pattern":"wear a hat","note":"کلاه گذاشتن"},{"pattern":"put on / take off a hat","note":"کلاه گذاشتن / برداشتن"},{"pattern":"hat / cap","note":"cap کلاهِ لبه‌دار است"}],"examples":[{"en":"Wear a hat. The sun is very hot.","fa":"کلاه بگذار. آفتاب خیلی داغ است."},{"en":"He was wearing a black hat.","fa":"او یک کلاهِ سیاه گذاشته بود."}],"collocations":["wear a hat","a sun hat","a woolly hat","take off your hat"],"mistake":{"wrong":"I wear hat in winter.","right":"I wear a hat in winter.","why":"قبل از hat مفرد a لازم است."},"pronunciation":{"gb":"/hæt/","us":"/hæt/"},"check":[{"type":"cloze","id":"c1","text":"It's cold. Put on your coat and your ___.","answer":"hat","accept":["scarf"],"fa":"سرد است. کت و کلاهت را بپوش.","why":"hat = کلاه."},{"type":"choice","id":"q1","prompt":"She's wearing a red ___ on her head.","options":[{"text":"hat","ok":true,"why":"hat = کلاه."},{"text":"hot","ok":false,"why":"hot یعنی داغ."},{"text":"hate","ok":false,"why":"hate یعنی متنفر بودن."}]},{"type":"produce","id":"p1","prompt":"کلاهت را بردار.","frame":"Take off your ___.","answer":"hat","accept":[],"why":"take off your hat."}]}],"version":"965845c32681","order":675,"unit":9,"prerequisites":["lex:A1:clothes"],"released":false},{"id":"lex:A1:skirt","headword":"skirt","goals":["everyday","general"],"senses":[{"id":"lex:A1:skirt","pos":"noun","gloss":"دامن","meaning":"لباسِ زنانه که از کمر به پایین است. با dress (پیراهنِ بلندِ یک‌تکه) فرق دارد.","grammar":[{"pattern":"a long / short skirt","note":"دامنِ بلند / کوتاه"},{"pattern":"wear a skirt","note":"دامن پوشیدن"},{"pattern":"a skirt and a top","note":"دامن و بلوز"}],"examples":[{"en":"She's wearing a long blue skirt.","fa":"یک دامنِ بلندِ آبی پوشیده."},{"en":"This skirt is too short for me.","fa":"این دامن برایم خیلی کوتاه است."}],"collocations":["a long skirt","a short skirt","wear a skirt","a black skirt"],"mistake":{"wrong":"I want to buy a skirt long.","right":"I want to buy a long skirt.","why":"صفت قبل از اسم می‌آید."},"pronunciation":{"gb":"/skɜːt/","us":"/skɜːrt/"},"check":[{"type":"cloze","id":"c1","text":"She doesn't like trousers. She always wears a ___.","answer":"skirt","accept":["dress"],"fa":"شلوار دوست ندارد. همیشه دامن می‌پوشد.","why":"skirt = دامن."},{"type":"choice","id":"q1","prompt":"These skirts ___ very cheap.","options":[{"text":"are","ok":true,"why":"skirts جمع است: are."},{"text":"is","ok":false,"why":"با اسمِ جمع are لازم است."},{"text":"am","ok":false,"why":"am فقط با I می‌آید."}]},{"type":"produce","id":"p1","prompt":"یک دامنِ قرمز خریدم.","frame":"I bought a red ___.","answer":"skirt","accept":[],"why":"a red skirt."}]}],"version":"d4586fad9a35","order":676,"unit":9,"prerequisites":["lex:A1:clothes"],"released":false},{"id":"lex:A1:trousers","headword":"trousers","goals":["everyday","general"],"senses":[{"id":"lex:A1:trousers","pos":"noun","gloss":"شلوار","meaning":"لباسی که از کمر تا پا را می‌پوشاند. به معنیِ شلوار همیشه جمع است: these trousers are … در آمریکا pants.","grammar":[{"pattern":"trousers + plural verb","note":"My trousers are …"},{"pattern":"a pair of trousers","note":"یک شلوار"},{"pattern":"trousers / pants","note":"بریتانیایی / آمریکایی"}],"examples":[{"en":"I need some new trousers for work.","fa":"برای کار چند شلوارِ نو لازم دارم."},{"en":"Your trousers are too long.","fa":"شلوارت خیلی بلند است."}],"collocations":["a pair of trousers","long trousers","black trousers","new trousers"],"usage":"در انگلیسیِ بریتانیایی pants یعنی لباسِ زیر؛ شلوار را trousers بگو.","mistake":{"wrong":"This trousers is too short.","right":"These trousers are too short.","why":"trousers جمع است: these … are."},"pronunciation":{"gb":"/ˈtraʊzəz/","us":"/ˈtraʊzərz/"},"tts":{"gb":"tɹˈaʊzəz","us":"tɹˈaʊzɚz"},"check":[{"type":"cloze","id":"c1","