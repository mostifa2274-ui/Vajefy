ه است."},{"text":"wear","ok":false,"why":"yesterday گذشته می‌خواهد."}]},{"type":"produce","id":"p1","prompt":"در مدرسه لباس فرم می‌پوشیم.","frame":"We ___ a uniform at school.","answer":"wear","accept":[],"why":"wear = به تن داشتن."}]}],"version":"84901136a012","order":678,"unit":9,"prerequisites":["lex:A1:clothes"],"released":false},{"id":"lex:A1:put","headword":"put","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:put","pos":"verb","gloss":"گذاشتن؛ قرار دادن","meaning":"چیزی را در جایی قرار دادن. همیشه جای آن را هم می‌گوییم: put it on the table. بی‌قاعده: put / put / put.","grammar":[{"pattern":"put + thing + place","note":"put the cup on the table, put the keys in your bag"},{"pattern":"put on + clothes","note":"پوشیدن: Put on your coat."},{"pattern":"put / put / put","note":"گذشته هم put است."}],"examples":[{"en":"Please put the book on the table.","fa":"لطفاً کتاب را روی میز بگذار."},{"en":"Where did you put my keys?","fa":"کلیدهایم را کجا گذاشتی؟"}],"collocations":["put on","put away","put down","put in"],"mistake":{"wrong":"Yesterday I putted my bag here.","right":"Yesterday I put my bag here.","why":"put بی‌قاعده است و گذشته‌اش هم put است."},"pronunciation":{"gb":"/pʊt/","us":"/pʊt/","note":"u کوتاه است، مثل «او» کوتاه: «پوت» (برخلاف but /bʌt/)."},"check":[{"type":"cloze","id":"c1","text":"___ your coat on. It's cold outside.","answer":"Put","accept":[],"fa":"کتت را بپوش. بیرون سرد است.","why":"put on = پوشیدن."},{"type":"choice","id":"q1","prompt":"Last night I ___ the milk in the fridge.","options":[{"text":"put","ok":true,"why":"گذشتهٔ put هم put است."},{"text":"putted","ok":false,"why":"put بی‌قاعده است."},{"text":"puts","ok":false,"why":"last night گذشته می‌خواهد."}]},{"type":"produce","id":"p1","prompt":"کفش‌هایت را کنار در بگذار.","frame":"___ your shoes by the door.","answer":"Put","accept":[],"why":"put + چیز + جا."}]}],"version":"bf7799eb3e63","order":679,"unit":9,"prerequisites":["lex:A1:wear"],"released":false},{"id":"lex:A1:on","headword":"on","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:on","pos":"preposition","gloss":"روی؛ در (روز)","meaning":"برای قرار گرفتن روی یک سطح (on the table) و برای روزها و تاریخ‌ها (on Monday, on 5 May). همچنین برای وسایل نقلیهٔ عمومی: on the bus.","grammar":[{"pattern":"on + surface","note":"on the wall, on the floor"},{"pattern":"on + day / date","note":"on Friday, on my birthday"},{"pattern":"on the bus / train / plane","note":"اما in a car / in a taxi"}],"examples":[{"en":"Your keys are on the table.","fa":"کلیدهایت روی میز است."},{"en":"The shop is closed on Fridays.","fa":"مغازه جمعه‌ها بسته است."}],"collocations":["on time","on the phone","on TV","turn on"],"mistake":{"wrong":"I read a book in the bus.","right":"I read a book on the bus.","why":"برای اتوبوس، قطار و هواپیما on می‌آید، نه in."},"pronunciation":{"gb":"/ɒn/","us":"/ɑːn/"},"check":[{"type":"cloze","id":"c1","text":"There is a picture ___ the wall.","answer":"on","accept":[],"fa":"یک عکس روی دیوار است.","why":"روی یک سطح."},{"type":"choice","id":"q1","prompt":"My birthday is ___ 12 March.","options":[{"text":"on","ok":true,"why":"تاریخ با on."},{"text":"in","ok":false,"why":"in برای ماهِ تنها است (in March)."},{"text":"at","ok":false,"why":"at برای ساعت است."}]},{"type":"produce","id":"p1","prompt":"چهارشنبه کلاس دارم.","frame":"I have a class ___ Wednesday.","answer":"on","accept":[],"why":"روز هفته با on."}]}],"version":"ff6e0311d4f5","order":680,"unit":9,"prerequisites":["lex:A1:put"],"released":false},{"id":"lex:A1:off","headword":"off","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:off","pos":"adverb","gloss":"خاموش؛ جدا؛ پیاده","meaning":"برای خاموش کردن (turn off)، درآوردن لباس (take off)، پیاده شدن از اتوبوس و قطار (get off)، یا تعطیل بودن (a day off). مقابل on.","grammar":[{"pattern":"turn / switch off","note":"خاموش کردن"},{"pattern":"take off (clothes)","note":"درآوردن"},{"pattern":"get off (bus / train)","note":"پیاده شدن"},{"pattern":"a day off","note":"یک روز مرخصی"}],"examples":[{"en":"Turn off the light.","fa":"چراغ را خاموش کن."},{"en":"Get off the bus at the next stop.","fa":"در ایستگاه بعدی از اتوبوس پیاده شو."}],"collocations":["turn off","take off","get off","a day off"],"mistake":{"wrong":"Please close the TV.","right":"Please turn off the TV.","why":"برای خاموش کردن وسایل برقی turn off می‌گوییم، نه close."},"pronunciation":{"gb":"/ɒf/","us":"/ɔːf/"},"check":[{"type":"cloze","id":"c1","text":"Take ___ your shoes before you come in.","answer":"off","accept":[],"fa":"قبل از اینکه بیایی داخل، کفش‌هایت را دربیاور.","why":"take off = درآوردن."},{"type":"choice","id":"q1","prompt":"We need to get ___ the train at the next station.","options":[{"text":"off","ok":true,"why":"get off = پیاده شدن."},{"text":"down","ok":false,"why":"get down از قطار طبیعی نیست."},{"text":"out","ok":false,"why":"get out of the train لازم است، نه get out the train."}]},{"type":"produce","id":"p1","prompt":"لطفاً تلویزیون را خاموش کن.","frame":"Please turn ___ the TV.","answer":"off","accept":[],"why":"turn off = خاموش کردن."}]}],"version":"8b1f8563389c","order":681,"unit":9,"prerequisites":["lex:A1:on"],"released":false},{"id":"lex:A1:summer","headword":"summer","goals":["everyday","general"],"senses":[{"id":"lex:A1:summer","pos":"noun","gloss":"تابستان","meaning":"گرم‌ترین فصل سال. in (the) summer = در تابستان؛ با this / next / last، حرف اضافه نمی‌آید.","grammar":[{"pattern":"in (the) summer","note":"در تابستان"},{"pattern":"this / next / last summer","note":"بدون in"},{"pattern":"summer + noun","note":"the summer holidays"}],"examples":[{"en":"We go to the beach in summer.","fa":"تابستان‌ها به ساحل می‌رویم."},{"en":"Last summer we visited my uncle in Shiraz.","fa":"تابستان گذشته به دیدن عمویم در شیراز رفتیم."}],"collocations":["in summer","last summer","the summer holidays","a hot summer"],"mistake":{"wrong":"We travelled in last summer.","right":"We travelled last summer.","why":"قبل از last، next و this حرف اضافه نمی‌آید."},"pronunciation":{"gb":"/ˈsʌmə/","us":"/ˈsʌmɚ/"},"check":[{"type":"cloze","id":"c1","text":"It's very hot here in ___.","answer":"summer","accept":[],"fa":"اینجا تابستان‌ها خیلی گرم است.","why":"in summer."},{"type":"choice","id":"q1","prompt":"We went to the sea ___ summer.","options":[{"text":"last","ok":true,"why":"last summer، بدون in."},{"text":"in last","ok":false,"why":"قبل از last حرف اضافه نمی‌آید."},{"text":"at","ok":false,"why":"at summer غلط است."}]},{"type":"produce","id":"p1","prompt":"تابستان را دوست دارم.","frame":"I love ___.","answer":"summer","accept":[],"why":"summer = تابستان."}]}],"version":"f40709e11996","order":682,"unit":9,"prerequisites":["lex:A1:weather","lex:A1:hot"],"released":false},{"id":"lex:A1:spring","headword":"spring","goals":["everyday","general"],"senses":[{"id":"lex:A1:spring","pos":"noun","gloss":"بهار","meaning":"فصلِ بینِ زمستان و تابستان. in spring یا in the spring؛ با next و last، in نمی‌آید.","grammar":[{"pattern":"in (the) spring","note":"در بهار"},{"pattern":"spring + noun","note":"spring flowers"},{"pattern":"last / next spring","note":"بهار گذشته / آینده؛ بدون in"}],"examples":[{"en":"The trees are full of flowers in spring.","fa":"در بهار درخت‌ها پر از شکوفه‌اند."},{"en":"The weather is lovely in the spring.","fa":"هوا در بهار عالی است."}],"collocations":["in spring","early spring","last spring","spring flowers"],"mistake":{"wrong":"I'll see you in next spring.","right":"I'll see you next spring.","why":"با next و last، in نمی‌آید."},"pronunciation":{"gb":"/sprɪŋ/","us":"/sprɪŋ/"},"check":[{"type":"cloze","id":"c1","text":"Winter, ___, summer, autumn.","answer":"spring","accept":[],"fa":"زمستان، بهار، تابستان، پاییز.","why":"فصلِ بعد از winter: spring."},{"type":"choice","id":"q1","prompt":"Many flowers open ___ spring.","options":[{"text":"in","ok":true,"why":"با فصل‌ها in می‌آید."},{"text":"on","ok":false,"why":"on برای روزهاست."},{"text":"at","ok":false,"why":"at spring غلط است."}]},{"type":"prod