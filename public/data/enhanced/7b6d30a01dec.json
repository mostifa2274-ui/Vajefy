at"],"mistake":{"wrong":"I bought a new cot for winter.","right":"I bought a new coat for winter.","why":"cot یعنی تختِ بچه؛ پالتو coat است."},"pronunciation":{"gb":"/kəʊt/","us":"/koʊt/","note":"oa مثل «اُو»: «کُوت»."},"check":[{"type":"cloze","id":"c1","text":"It's snowing. Don't forget your ___.","answer":"coat","accept":["jacket"],"fa":"برف می‌بارد. پالتویت را فراموش نکن.","why":"coat = پالتو."},{"type":"choice","id":"q1","prompt":"It's cold. Put ___ your coat.","options":[{"text":"on","ok":true,"why":"put on = پوشیدن."},{"text":"in","ok":false,"why":"put in یعنی گذاشتن داخلِ چیزی."},{"text":"up","ok":false,"why":"put up یعنی بالا بردن یا نصب کردن."}]},{"type":"produce","id":"p1","prompt":"پالتویت را دربیاور.","frame":"Take off your ___.","answer":"coat","accept":[],"why":"take off your coat."}]}],"version":"980826a9fc1b","order":679,"unit":9,"prerequisites":["lex:A1:clothes","lex:A1:cold"],"released":false},{"id":"lex:A1:jacket","headword":"jacket","goals":["everyday","general"],"senses":[{"id":"lex:A1:jacket","pos":"noun","gloss":"کت؛ کاپشن","meaning":"لباسِ کوتاه با آستین و جلوی باز که روی لباس‌های دیگر می‌پوشید؛ سبک‌تر و کوتاه‌تر از coat. «ژاکتِ» بافتنی در انگلیسی sweater یا cardigan است.","grammar":[{"pattern":"a leather / denim jacket","note":"کت چرمی / جین"},{"pattern":"put on a jacket","note":"کت پوشیدن"},{"pattern":"a jacket and tie","note":"کت و کراوات"}],"examples":[{"en":"Take a jacket. It might be cold tonight.","fa":"یک کاپشن بردار. شاید امشب سرد باشد."},{"en":"He's wearing a black jacket and jeans.","fa":"او یک کت مشکی و شلوار جین پوشیده."}],"collocations":["a leather jacket","a warm jacket","put on a jacket","a jacket pocket"],"mistake":{"wrong":"I'm wearing a wool jacket that I pull over my head.","right":"I'm wearing a sweater.","why":"لباسِ بافتنی که از سر می‌پوشید sweater است؛ jacket جلوباز است."},"pronunciation":{"gb":"/ˈdʒækɪt/","us":"/ˈdʒækɪt/"},"check":[{"type":"cloze","id":"c1","text":"My phone is in my ___ pocket.","answer":"jacket","ac