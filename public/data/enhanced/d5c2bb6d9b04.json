ool today. I'm ___.","answer":"sick","accept":["ill"],"fa":"امروز نمی‌توانم مدرسه بروم. مریضم.","why":"sick = مریض."},{"type":"choice","id":"q1","prompt":"She's in bed because she's ___.","options":[{"text":"sick","ok":true,"why":"بیمار است، پس در رختخواب است."},{"text":"healthy","ok":false,"why":"healthy یعنی سالم."},{"text":"well","ok":false,"why":"well اینجا یعنی سالم."}]},{"type":"produce","id":"p1","prompt":"امروز مریضم.","frame":"I'm ___ today.","answer":"sick","accept":["ill"],"why":"sick = مریض."}]}],"version":"3da266927e1d","order":777,"released":false},{"id":"lex:A1:sixty","headword":"sixty","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:sixty","pos":"number","gloss":"شصت","meaning":"عدد ۶۰. sixteen = ۱۶ (تکیه روی بخش دوم)؛ sixty = ۶۰ (تکیه روی بخش اول).","grammar":[{"pattern":"sixty + plural noun","note":"sixty minutes"},{"pattern":"sixty-one, sixty-two …","note":"با خط تیره"},{"pattern":"sixty / sixteen","note":"۶۰ / ۱۶"}],"examples":[{"en":"The bus has sixty seats.","fa":"اتوبوس شصت صندلی دارد."},{"en":"Sixty people came to the wedding.","fa":"شصت نفر به عروسی آمدند."}],"collocations":["sixty minutes","sixty years old","sixty-five","about sixty"],"mistake":{"wrong":"There are sixty minute in an hour.","right":"There are sixty minutes in an hour.","why":"بعد از عدد اسمِ جمع می‌آید."},"pronunciation":{"gb":"/ˈsɪksti/","us":"/ˈsɪksti/"},"check":[{"type":"cloze","id":"c1","text":"An hour has ___ minutes.","answer":"sixty","accept":["60"],"fa":"یک ساعت شصت دقیقه دارد.","why":"۶۰ = sixty."},{"type":"choice","id":"q1","prompt":"How do you write 60 in words?","options":[{"text":"sixty","ok":true,"why":"۶۰ = sixty."},{"text":"sixteen","ok":false,"why":"sixteen = ۱۶."},{"text":"sixthy","ok":false,"why":"املای درست: sixty."}]},{"type":"produce","id":"p1","prompt":"پدربزرگم شصت سال دارد.","frame":"My grandfather is ___.","answer":"sixty","accept":["60"],"why":"sixty = شصت."}]}],"version":"12ac4ff6dfc5","order":778,"released":false},{"id":"lex