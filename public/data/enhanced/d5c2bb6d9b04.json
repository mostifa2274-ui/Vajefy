{"entries":[{"id":"lex:A1:september","headword":"September","goals":["everyday","general"],"senses":[{"id":"lex:A1:september","pos":"noun","gloss":"سپتامبر","meaning":"ماهِ نهمِ سالِ میلادی. همیشه با حرف بزرگ نوشته می‌شود. با ماه in، با تاریخ on.","grammar":[{"pattern":"in September","note":"در سپتامبر"},{"pattern":"on 5 September","note":"با تاریخ: on"},{"pattern":"last / next September","note":"بدون in"}],"examples":[{"en":"School starts in September.","fa":"مدرسه در سپتامبر شروع می‌شود."},{"en":"The weather is still warm in September.","fa":"در سپتامبر هوا هنوز گرم است."}],"collocations":["in September","early September","next September","the end of September"],"mistake":{"wrong":"My birthday is in September 5.","right":"My birthday is on 5 September.","why":"با تاریخِ کامل on می‌آید؛ با ماهِ تنها in."},"pronunciation":{"gb":"/sepˈtembə/","us":"/sepˈtembər/"},"check":[{"type":"cloze","id":"c1","text":"July, August, ___, October.","answer":"September","accept":[],"fa":"ژوئیه، اوت، سپتامبر، اکتبر.","why":"ماهِ بعد از August: September."},{"type":"choice","id":"q1","prompt":"Our new class starts ___ 10 September.","options":[{"text":"on","ok":true,"why":"با تاریخ on می‌آید."},{"text":"in","ok":false,"why":"in با ماهِ تنهاست، نه با تاریخ."},{"text":"at","ok":false,"why":"at برای ساعت است."}]},{"type":"produce","id":"p1","prompt":"سپتامبر بعد از اوت می‌آید.","frame":"___ comes after August.","answer":"September","accept":[],"why":"September = سپتامبر."}]}],"version":"3ccf983f13e2","order":775,"released":false},{"id":"lex:A1:sheep","headword":"sheep","goals":["everyday","general"],"senses":[{"id":"lex:A1:sheep","pos":"noun","gloss":"گوسفند","meaning":"حیوانِ مزرعه که از پشمش لباس درست می‌کنند. جمعش هم sheep است: one sheep، ten sheep.","grammar":[{"pattern":"one sheep / two sheep","note":"جمع بدون s"},{"pattern":"a lot of sheep","note":"گوسفندِ زیاد"},{"pattern":"sheep / ship","note":"گوسفند / کشتی"}],"examples":[{"en":"There are a lot of sheep on the hill.","fa":"روی ت