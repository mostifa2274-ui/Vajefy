:"a banana."},{"type":"choice","id":"q1","prompt":"How many ___ do you want?","options":[{"text":"bananas","ok":true,"why":"بعد از how many جمع."},{"text":"banana","ok":false,"why":"بعد از how many اسم جمع لازم است."},{"text":"bananaes","ok":false,"why":"جمعِ banana فقط s می‌گیرد."}]},{"type":"produce","id":"p1","prompt":"موز دوست دارم.","frame":"I like ___.","answer":"bananas","accept":[],"why":"به‌طور کلی جمع: bananas."}]}],"version":"2d6131aee911","order":802,"released":false},{"id":"lex:A1:bath","headword":"bath","goals":["everyday","general"],"senses":[{"id":"lex:A1:bath","pos":"noun","gloss":"وان؛ حمام کردن","meaning":"وانِ حمام، یا شستنِ بدن در وان: have a bath (بریتانیایی) یا take a bath (آمریکایی).","grammar":[{"pattern":"have / take a bath","note":"حمام کردن (در وان)"},{"pattern":"in the bath","note":"در وان"},{"pattern":"bath / shower","note":"وان / دوش"}],"examples":[{"en":"I usually have a bath before bed.","fa":"معمولاً قبل از خواب حمام می‌کنم."},{"en":"The children are in the bath.","fa":"بچه‌ها در وان هستند."}],"collocations":["have a bath","take a bath","a hot bath","bath time"],"mistake":{"wrong":"I do a bath every day.","right":"I have a bath every day.","why":"حمام کردن: have a bath."},"pronunciation":{"gb":"/bɑːθ/","us":"/bæθ/"},"tts":{"gb":"bˈɑːθ"},"check":[{"type":"cloze","id":"c1","text":"I'm cold. I think I'll have a hot ___.","answer":"bath","accept":["shower","drink","tea"],"fa":"سردم است. فکر کنم با آب داغ حمام کنم.","why":"have a bath."},{"type":"choice","id":"q1","prompt":"She ___ a bath every evening.","options":[{"text":"has","ok":true,"why":"have a bath."},{"text":"does","ok":false,"why":"do a bath غلط است."},{"text":"makes","ok":false,"why":"make a bath غلط است."}]},{"type":"produce","id":"p1","prompt":"بچه را در وان گذاشتم.","frame":"I put the baby in the ___.","answer":"bath","accept":[],"why":"in the bath."}]}],"version":"44462e7d63ed","order":803,"released":false},{"id":"lex:A1:blog","headword":"blog","goals":["everyday","work",