":["everyday","work","study","general"],"senses":[{"id":"lex:A1:tired","pos":"adjective","gloss":"خسته","meaning":"نیاز به استراحت یا خواب داشتن. tired of = خسته و دلزده از چیزی.","grammar":[{"pattern":"be / feel / look tired","note":"I feel tired."},{"pattern":"tired of + noun / -ing","note":"I'm tired of waiting."}],"examples":[{"en":"I'm too tired to cook tonight.","fa":"امشب خسته‌تر از آنم که آشپزی کنم."},{"en":"You look tired. Go to bed.","fa":"خسته به نظر می‌رسی. برو بخواب."}],"collocations":["very tired","tired of","feel tired"],"mistake":{"wrong":"I am tiring after work.","right":"I am tired after work.","why":"tired حسِ آدم است؛ tiring یعنی «خسته‌کننده» و برای کار یا سفر به کار می‌رود."},"pronunciation":{"gb":"/ˈtaɪəd/","us":"/ˈtaɪɚd/","note":"ed اینجا «د» خوانده می‌شود و هجای جدا نیست: «تایِرد»."},"check":[{"type":"cloze","id":"c1","text":"After the long trip, we were very ___.","answer":"tired","accept":[],"fa":"بعد از سفر طولانی خیلی خسته بودیم.","why":"حس آدم: tired."},{"type":"choice","id":"q1","prompt":"The journey was long and ___.","options":[{"text":"tiring","ok":true,"why":"صفتِ سفر: خسته‌کننده."},{"text":"tired","ok":false,"why":"سفر خسته نمی‌شود؛ آدم خسته می‌شود."},{"text":"tire","ok":false,"why":"tire فعل یا اسم (لاستیک) است."}]},{"type":"produce","id":"p1","prompt":"از منتظر ماندن خسته شده‌ام.","frame":"I'm ___ of waiting.","answer":"tired","accept":[],"why":"tired of + ing."}]}],"version":"4e11c3dc979c","order":755,"unit":10,"prerequisites":["lex:A1:feel"],"released":false},{"id":"lex:A1:afraid","headword":"afraid","goals":["everyday","general"],"senses":[{"id":"lex:A1:afraid","pos":"adjective","gloss":"ترسیده","meaning":"وقتی از چیزی می‌ترسی. afraid of + اسم یا -ing. afraid قبل از اسم نمی‌آید: a frightened boy، نه an afraid boy.","grammar":[{"pattern":"be afraid of + noun","note":"I'm afraid of dogs."},{"pattern":"be afraid of + -ing","note":"She's afraid of flying."},{"pattern":"be afraid (+ نه قبل از اسم)","note":"The boy is afraid."}],"examples":[{"en":"My little brother is afraid of the dark.","fa":"برادر کوچکم از تاریکی می‌ترسد."},{"en":"Don't be afraid — the dog is very friendly.","fa":"نترس، سگ خیلی مهربان است."}],"collocations":["afraid of dogs","afraid of the dark","afraid of flying","very afraid"],"usage":"I'm afraid + جمله یعنی «متأسفانه» و مؤدبانه است: I'm afraid the shop is closed.","mistake":{"wrong":"I'm afraid from dogs.","right":"I'm afraid of dogs.","why":"afraid با of می‌آید، نه from."},"pronunciation":{"gb":"/əˈfreɪd/","us":"/əˈfreɪd/"},"check":[{"type":"cloze","id":"c1","text":"Are you ___ of big dogs?","answer":"afraid","accept":["scared","frightened"],"fa":"از سگ‌های بزرگ می‌ترسی؟","why":"be afraid of."},{"type":"choice","id":"q1","prompt":"She's afraid ___ flying.","options":[{"text":"of","ok":true,"why":"afraid of + -ing."},{"text":"from","ok":false,"why":"afraid from غلط است."},{"text":"to","ok":false,"why":"afraid to fly درست است، ولی afraid to flying نه."}]},{"type":"produce","id":"p1","prompt":"من از گربه‌ها نمی‌ترسم.","frame":"I'm not ___ of cats.","answer":"afraid","accept":["scared"],"why":"be afraid of."}]}],"version":"cd63e083eb8f","order":756,"unit":10,"prerequisites":["lex:A1:feel"],"released":false},{"id":"lex:A1:body","headword":"body","goals":["everyday","general"],"senses":[{"id":"lex:A1:body","pos":"noun","gloss":"بدن","meaning":"همهٔ بخش‌های جسمِ آدم یا حیوان. parts of the body = اعضای بدن. جمع: bodies.","grammar":[{"pattern":"the human body","note":"بدن انسان"},{"pattern":"parts of the body","note":"اعضای بدن"},{"pattern":"bodies","note":"جمع؛ y به ies"}],"examples":[{"en":"Sleep is important for your body and mind.","fa":"خواب برای بدن و ذهنت مهم است."},{"en":"We learned the parts of the body in English.","fa":"اعضای بدن را به انگلیسی یاد گرفتیم."}],"collocations":["the human body","parts of the body","a healthy body","body and mind"],"mistake":{"wrong":"Our bodys need water.","right":"Our bodies need water.","why":"جمع body: bodies."},"pronunciation":{"gb":"