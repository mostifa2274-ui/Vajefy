{"entries":[{"id":"lex:A1:prepare","headword":"prepare","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:prepare","pos":"verb","gloss":"آماده کردن؛ آماده شدن","meaning":"چیزی را آماده کردن، یا خودت را برای چیزی آماده کردن: prepare for an exam. preparation = آمادگی.","grammar":[{"pattern":"prepare + noun","note":"prepare dinner"},{"pattern":"prepare for + noun","note":"برای … آماده شدن"},{"pattern":"prepare to + verb","note":"آمادهٔ کاری شدن"}],"examples":[{"en":"My mother is preparing lunch.","fa":"مادرم دارد ناهار آماده می‌کند."},{"en":"We are preparing for the exam.","fa":"داریم برای امتحان آماده می‌شویم."}],"collocations":["prepare a meal","prepare for an exam","prepare a room","well prepared"],"mistake":{"wrong":"I'm preparing myself to the test.","right":"I'm preparing for the test.","why":"آماده شدن برای چیزی: prepare for."},"pronunciation":{"gb":"/prɪˈpeə/","us":"/prɪˈper/"},"check":[{"type":"cloze","id":"c1","text":"Can you help me ___ the room for our guests?","answer":"prepare","accept":["clean"],"fa":"می‌توانی کمکم کنی اتاق را برای مهمان‌ها آماده کنم؟","why":"prepare a room."},{"type":"choice","id":"q1","prompt":"She's preparing ___ her driving test.","options":[{"text":"for","ok":true,"why":"prepare for."},{"text":"to","ok":false,"why":"prepare to + اسم غلط است."},{"text":"on","ok":false,"why":"prepare on غلط است."}]},{"type":"produce","id":"p1","prompt":"دارم شام آماده می‌کنم.","frame":"I'm ___ dinner.","answer":"preparing","accept":["making","cooking"],"why":"be + -ing: preparing."}]}],"version":"1e5ece94fab8","order":650,"released":false},{"id":"lex:A1:radio","headword":"radio","goals":["everyday","general"],"senses":[{"id":"lex:A1:radio","pos":"noun","gloss":"رادیو","meaning":"دستگاه یا برنامه‌ای که صدا و موسیقی پخش می‌کند. on the radio = از رادیو.","grammar":[{"pattern":"listen to the radio","note":"رادیو گوش دادن"},{"pattern":"on the radio","note":"از رادیو"},{"pattern":"a radio programme","note":"برنامهٔ رادیویی"}],"examples":[{"en":"My father listens to the news on the radio.","fa":"پدرم اخبار را از رادیو گوش می‌دهد."},{"en":"Turn up the radio! I love this song.","fa":"صدای رادیو را زیاد کن! این آهنگ را خیلی دوست دارم."}],"collocations":["listen to the radio","on the radio","a radio station","turn on the radio"],"mistake":{"wrong":"I heard it in the radio.","right":"I heard it on the radio.","why":"از رادیو: on the radio."},"pronunciation":{"gb":"/ˈreɪdiəʊ/","us":"/ˈreɪdioʊ/"},"check":[{"type":"cloze","id":"c1","text":"I listen to the ___ in the car.","answer":"radio","accept":["music"],"fa":"در ماشین رادیو گوش می‌دهم.","why":"listen to the radio."},{"type":"choice","id":"q1","prompt":"There's a good programme ___ the radio.","options":[{"text":"on","ok":true,"why":"on the radio."},{"text":"in","ok":false,"why":"in the radio غلط است."},{"text":"at","ok":false,"why":"at the radio غلط است."}]},{"type":"produce","id":"p1","prompt":"رادیو گوش می‌دهی؟","frame":"Do you listen to the ___?","answer":"radio","accept":[],"why":"listen to the radio."}]}],"version":"90dfc131b7e7","order":651,"released":false},{"id":"lex:A1:repeat","headword":"repeat","goals":["study","general"],"senses":[{"id":"lex:A1:repeat","pos":"verb","gloss":"تکرار کردن","meaning":"دوباره گفتن یا انجام دادن. Can you repeat that, please? = می‌شود تکرار کنید؟ repeat خودش «دوباره» را دارد.","grammar":[{"pattern":"repeat + noun","note":"repeat the word"},{"pattern":"Can you repeat that?","note":"می‌شود تکرار کنید؟"},{"pattern":"repeat after me","note":"بعد از من تکرار کن"}],"examples":[{"en":"Can you repeat the question, please?","fa":"می‌شود سؤال را تکرار کنید؟"},{"en":"Repeat after me: 'Good morning.'","fa":"بعد از من تکرار کن: «صبح بخیر.»"}],"collocations":["repeat after me","repeat the question","repeat a word","please repeat"],"mistake":{"wrong":"Can you repeat me the question?","right":"Can you repeat the question?","why":"repeat مفعولِ شخص نمی‌گیرد؛ me لازم نیست."},"pronunciation":{"gb":"/rɪˈpiːt/","us":"/rɪˈpiːt/"},"check":[{"type":"cloze","id":"c1","text":"Sorry, I didn't hear you. Can you ___ that?","answer":"repeat","accept":["say"],"fa":"ببخشید، نشنیدم. می‌شود تکرار کنید؟","why":"repeat that."},{"type":"choice","id":"q1","prompt":"The teacher said a word and we ___ it.","options":[{"text":"repeated","ok":true,"why":"گذشته: repeated."},{"text":"repeat again","ok":false,"why":"repeat خودش یعنی دوباره."},{"text":"repeating","ok":false,"why":"اینجا فعل گذشته لازم است."}]},{"type":"produce","id":"p1","prompt":"لطفاً تکرار کنید.","frame":"Please ___ that.","answer":"repeat","accept":[],"why":"repeat that."}]}],"version":"48c9c7d28022","order":652,"released":false},{"id":"lex:A1:rich","headword":"rich","goals":["everyday","general"],"senses":[{"id":"lex:A1:rich","pos":"adjective","gloss":"ثروتمند","meaning":"کسی که پولِ زیادی دارد. ضدش poor. get rich = پولدار شدن.","grammar":[{"pattern":"rich / poor","note":"ثروتمند / فقیر"},{"pattern":"get rich","note":"ثروتمند شدن"},{"pattern":"rich and famous","note":"ثروتمند و مشهور"}],"examples":[{"en":"He's very rich. He has three houses.","fa":"او خیلی ثروتمند است. سه خانه دارد."},{"en":"She wants to be rich one day.","fa":"او می‌خواهد یک روز ثروتمند شود."}],"collocations":["very rich","get rich","rich and famous","a rich family"],"mistake":{"wrong":"He is a rich.","right":"He is rich.","why":"صفت تنها بعد از a نمی‌آید."},"pronunciation":{"gb":"/rɪtʃ/","us":"/rɪtʃ/"},"check":[{"type":"cloze","id":"c1","text":"The opposite of poor is ___.","answer":"rich","accept":[],"fa":"ضدِ فقیر ثروتمند است.","why":"rich ↔ poor."},{"type":"choice","id":"q1","prompt":"If you work hard, maybe you'll get ___.","options":[{"text":"rich","ok":true,"why":"get rich."},{"text":"richly","ok":false,"why":"بعد از get اینجا صفت لازم است."},{"text":"riches","ok":false,"why":"riches اسم است."}]},{"type":"produce","id":"p1","prompt":"خانواده‌اش ثروتمند است.","frame":"His family is ___.","answer":"rich","accept":[],"why":"rich = ثروتمند."}]}],"version":"d09f13a25132","order":6