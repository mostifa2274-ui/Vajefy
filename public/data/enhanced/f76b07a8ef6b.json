","accept":[],"why":"a special present."}]}],"version":"204676478b07","order":657,"released":false},{"id":"lex:A1:sport","headword":"sport","goals":["everyday","general"],"senses":[{"id":"lex:A1:sport","pos":"noun","gloss":"ورزش","meaning":"بازی یا فعالیتِ بدنی با قانون، مثل فوتبال و شنا. do / play sport. آمریکایی‌ها بیشتر sports می‌گویند.","grammar":[{"pattern":"do / play sport","note":"ورزش کردن"},{"pattern":"a sport","note":"یک ورزش"},{"pattern":"sports + noun","note":"sports shoes"}],"examples":[{"en":"Football is the most popular sport in Iran.","fa":"فوتبال محبوب‌ترین ورزش در ایران است."},{"en":"I don't do much sport.","fa":"زیاد ورزش نمی‌کنم."}],"collocations":["play sport","do sport","a team sport","a sports centre"],"mistake":{"wrong":"Swimming is my favourite sports.","right":"Swimming is my favourite sport.","why":"مفرد: my favourite sport."},"pronunciation":{"gb":"/spɔːt/","us":"/spɔːrt/"},"check":[{"type":"cloze","id":"c1","text":"Tennis is my favourite ___.","answer":"sport","accept":["game"],"fa":"تنیس ورزش مورد علاقهٔ من است.","why":"my favourite sport."},{"type":"choice","id":"q1","prompt":"I watch a lot of ___ on TV.","options":[{"text":"sport","ok":true,"why":"sport = ورزش."},{"text":"sporty","ok":false,"why":"sporty صفت است."},{"text":"sporting","ok":false,"why":"sporting اینجا غلط است."}]},{"type":"produce","id":"p1","prompt":"ورزش کردن برایت خوب است.","frame":"Doing ___ is good for you.","answer":"sport","accept":["sports"],"why":"do sport."}]}],"version":"3eec2e4be895","order":658,"released":false},{"id":"lex:A1:swim","headword":"swim","goals":["everyday","general"],"senses":[{"id":"lex:A1:swim","pos":"verb","gloss":"شنا کردن","meaning":"در آب با دست و پا حرکت کردن. بی‌قاعده: swam، swum. go swimming = به شنا رفتن.","grammar":[{"pattern":"swim – swam – swum","note":"بی‌قاعده"},{"pattern":"go swimming","note":"به شنا رفتن"},{"pattern":"swim in the sea / a pool","note":"در دریا / استخر شنا کردن"}],"examples":[{"en":"Can you swim?","fa":"شنا بلدی؟"},{"en":"We swam in the sea every day.","fa":"هر روز در دریا شنا کردیم."}],"collocations":["swim in the sea","go swimming","learn to swim","swim fast"],"mistake":{"wrong":"I swimmed yesterday.","right":"I swam yesterday.","why":"swim بی‌قاعده است: swam."},"pronunciation":{"gb":"/swɪm/","us":"/swɪm/"},"check":[{"type":"cloze","id":"c1","text":"Fish can ___, but they can't walk.","answer":"swim","accept":[],"fa":"ماهی می‌تواند شنا کند، ولی نمی‌تواند راه برود.","why":"can + swim."},{"type":"choice","id":"q1","prompt":"Last summer I ___ in the sea every morning.","options":[{"text":"swam","ok":true,"why":"گذشتهٔ swim: swam."},{"text":"swimmed","ok":false,"why":"swim بی‌قاعده است."},{"text":"swum","ok":false,"why":"swum بدون have نمی‌آید."}]},{"type":"produce","id":"p1","prompt":"دخترم شنا بلد است.","frame":"My daughter can ___.","answer":"swim","accept":[],"why":"can + swim."}]}],"version":"1119832c3c8c","order":659,"released":false},{"id":"lex:A1:taxi","headword":"taxi","goals":["everyday","general"],"senses":[{"id":"lex:A1:taxi","pos":"noun","gloss":"تاکسی","meaning":"ماشینی که با پرداخت پول ما را می‌برد. take a taxi = با تاکسی رفتن؛ by taxi = با تاکسی.","grammar":[{"pattern":"take a taxi","note":"تاکسی گرفتن"},{"pattern":"by taxi","note":"با تاکسی"},{"pattern":"call a taxi","note":"تاکسی خبر کردن"}],"examples":[{"en":"We took a taxi to the airport.","fa":"با تاکسی به فرودگاه رفتیم."},{"en":"Can you call a taxi for me, please?","fa":"می‌شود برایم یک تاکسی بگیرید؟"}],"collocations":["take a taxi","by taxi","a taxi driver","call a taxi"],"mistake":{"wrong":"We went with taxi.","right":"We went by taxi.","why":"با وسیلهٔ سفر by می‌آید."},"pronunciation":{"gb":"/ˈtæksi/","us":"/ˈtæksi/"},"check":[{"type":"cloze","id":"c1","text":"It's late and there are no buses. Let's take a ___.","answer":"taxi","accept":["cab"],"fa":"دیر است و اتوبوس نیست. بیا تاکسی بگیریم.","why":"take a taxi."},{"type":"choice","id":"q1","prompt":"I ___ a taxi home last night.","options":[{"text":"t