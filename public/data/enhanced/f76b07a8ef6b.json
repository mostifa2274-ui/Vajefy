o much salt","note":"نمکِ زیادی"}],"examples":[{"en":"This soup needs more salt.","fa":"این سوپ نمک بیشتری لازم دارد."},{"en":"Can you pass the salt, please?","fa":"می‌شود نمک را بدهی؟"}],"collocations":["salt and pepper","a little salt","too much salt","pass the salt"],"mistake":{"wrong":"There are too many salt.","right":"There is too much salt.","why":"salt غیرقابل‌شمارش است."},"pronunciation":{"gb":"/sɔːlt/","us":"/sɔːlt/"},"check":[{"type":"cloze","id":"c1","text":"Sea water has a lot of ___ in it.","answer":"salt","accept":[],"fa":"آب دریا نمکِ زیادی دارد.","why":"salt = نمک."},{"type":"choice","id":"q1","prompt":"Don't put too ___ salt in the food.","options":[{"text":"much","ok":true,"why":"غیرقابل‌شمارش: much."},{"text":"many","ok":false,"why":"many با غیرقابل‌شمارش نمی‌آید."},{"text":"lot","ok":false,"why":"too lot غلط است."}]},{"type":"produce","id":"p1","prompt":"نمک را بده.","frame":"Give me the ___.","answer":"salt","accept":[],"why":"salt = نمک."}]}],"version":"1152f3d6d6da","order":655,"released":false},{"id":"lex:A1:sell","headword":"sell","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:sell","pos":"verb","gloss":"فروختن","meaning":"چیزی را به کسی دادن و پول گرفتن. بی‌قاعده: sold، sold. ضدش buy.","grammar":[{"pattern":"sell – sold – sold","note":"بی‌قاعده"},{"pattern":"sell + thing + to + person","note":"… را به … فروختن"},{"pattern":"buy / sell","note":"خریدن / فروختن"}],"examples":[{"en":"This shop sells fruit and vegetables.","fa":"این مغازه میوه و سبزی می‌فروشد."},{"en":"He sold his car to his cousin.","fa":"او ماشینش را به پسرعمویش فروخت."}],"collocations":["sell a car","sell tickets","sell online","buy and sell"],"mistake":{"wrong":"I selled my bike.","right":"I sold my bike.","why":"sell بی‌قاعده است: sold."},"pronunciation":{"gb":"/sel/","us":"/sel/"},"check":[{"type":"cloze","id":"c1","text":"Do you ___ bread here? — Yes, fresh bread every morning.","answer":"sell","accept":["have"],"fa":"اینجا نان می‌فروشید؟ — بله، هر