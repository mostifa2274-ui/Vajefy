,"ok":false,"why":"into حرکت به داخل است."}]},{"type":"produce","id":"p1","prompt":"دریا را دوست دارم.","frame":"I love the ___.","answer":"sea","accept":[],"why":"the sea."}]}],"version":"ebb4aab4f6d4","order":503,"released":false},{"id":"lex:A1:slow","headword":"slow","goals":["everyday","general"],"senses":[{"id":"lex:A1:slow","pos":"adjective","gloss":"آهسته؛ کند","meaning":"چیزی که با سرعتِ کم حرکت یا کار می‌کند. ضدش fast یا quick. قیدش slowly است؛ تفضیلی: slower.","grammar":[{"pattern":"a slow + noun","note":"a slow train"},{"pattern":"be slow","note":"The internet is slow."},{"pattern":"slow / slowly","note":"صفت / قید"}],"examples":[{"en":"This computer is very slow.","fa":"این کامپیوتر خیلی کند است."},{"en":"Can you speak more slowly, please?","fa":"می‌شود لطفاً آهسته‌تر صحبت کنید؟"}],"collocations":["a slow train","very slow","slow down","slow internet"],"mistake":{"wrong":"This bus is more slow than the train.","right":"This bus is slower than the train.","why":"تفضیلیِ صفتِ یک‌بخشی: slower."},"pronunciation":{"gb":"/sləʊ/","us":"/sloʊ/"},"check":[{"type":"cloze","id":"c1","text":"The traffic is very ___ today. We'll be late.","answer":"slow","accept":["bad","heavy"],"fa":"امروز ترافیک خیلی کند است. دیر می‌رسیم.","why":"slow = کند."},{"type":"choice","id":"q1","prompt":"My old phone is very ___.","options":[{"text":"slow","ok":true,"why":"بعد از is صفت می‌آید."},{"text":"slowly","ok":false,"why":"slowly قید است."},{"text":"slowness","ok":false,"why":"slowness اسم است."}]},{"type":"produce","id":"p1","prompt":"اینترنت کند است.","frame":"The internet is ___.","answer":"slow","accept":[],"why":"slow = کند."}]}],"version":"82570a9a066d","order":504,"released":false},{"id":"lex:A1:someone","headword":"someone","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:someone","pos":"pronoun","gloss":"کسی؛ یک نفر","meaning":"یک آدمِ نامشخص؛ هم‌معنای somebody. مفرد است. در سؤال و جملهٔ منفی بیشتر anyone می‌آید.","grammar":[{"pattern":"someone + singu