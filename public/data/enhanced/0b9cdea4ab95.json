orning / night","note":"صبح / شبِ شنبه"}],"examples":[{"en":"I don't work on Saturdays.","fa":"شنبه‌ها کار نمی‌کنم."},{"en":"See you on Saturday!","fa":"شنبه می‌بینمت!"}],"collocations":["on Saturday","Saturday morning","next Saturday","every Saturday"],"mistake":{"wrong":"I'll see you in saturday.","right":"I'll see you on Saturday.","why":"با روزها on می‌آید و حرف اولِ روز بزرگ است."},"pronunciation":{"gb":"/ˈsætədeɪ/","us":"/ˈsætɚdeɪ/"},"check":[{"type":"cloze","id":"c1","text":"The shop is closed on Sundays but open on ___.","answer":"Saturdays","accept":["Saturday"],"fa":"مغازه یکشنبه‌ها بسته است اما شنبه‌ها باز است.","why":"on Saturdays."},{"type":"choice","id":"q1","prompt":"We have a party ___ Saturday.","options":[{"text":"on","ok":true,"why":"با روزها on."},{"text":"in","ok":false,"why":"in Saturday غلط است."},{"text":"at","ok":false,"why":"at Saturday غلط است."}]},{"type":"produce","id":"p1","prompt":"شنبه به پارک می‌رویم.","frame":"We're going to the park on ___.","answer":"Saturday","accept":["saturday"],"why":"on Saturday، با حرف بزرگ."}]}],"version":"8f3267f141cf","order":131,"unit":2,"prerequisites":["lex:A1:week","lex:A1:day"],"released":false},{"id":"lex:A1:sunday","headword":"Sunday","goals":["everyday","general"],"senses":[{"id":"lex:A1:sunday","pos":"noun","gloss":"یکشنبه","meaning":"روزِ بعد از شنبه؛ در کشورهای انگلیسی‌زبان روز تعطیل است. نام روزها با حرف بزرگ نوشته می‌شود. on Sunday؛ on Sundays = یکشنبه‌ها.","grammar":[{"pattern":"on Sunday","note":"یکشنبه"},{"pattern":"on Sundays","note":"یکشنبه‌ها"},{"pattern":"Sunday morning / night","note":"صبح / شبِ یکشنبه"}],"examples":[{"en":"Most shops are closed on Sundays.","fa":"بیشتر مغازه‌ها یکشنبه‌ها بسته‌اند."},{"en":"We had a big lunch on Sunday.","fa":"یکشنبه ناهار مفصلی خوردیم."}],"collocations":["on Sunday","Sunday morning","last Sunday","every Sunday"],"mistake":{"wrong":"See you at Sunday.","right":"See you on Sunday.","why":"با روزها on می‌آید."},"pronunciation":{"gb":"/ˈsʌndeɪ/","us":"/ˈsʌndeɪ/"},"check":[{"type":"cloze","id":"c1","text":"In England the weekend is Saturday and ___.","answer":"Sunday","accept":[],"fa":"در انگلستان آخر هفته شنبه و یکشنبه است.","why":"Sunday، با حرف بزرگ."},{"type":"choice","id":"q1","prompt":"What do you usually do ___ Sundays?","options":[{"text":"on","ok":true,"why":"با روزها on."},{"text":"in","ok":false,"why":"in Sundays غلط است."},{"text":"at","ok":false,"why":"at Sundays غلط است."}]},{"type":"produce","id":"p1","prompt":"یکشنبه به دیدنت می‌آیم.","frame":"I'll visit you on ___.","answer":"Sunday","accept":["sunday"],"why":"on Sunday."}]}],"version":"80a3717a0a9d","order":132,"unit":2,"prerequisites":["lex:A1:week","lex:A1:day"],"released":false},{"id":"lex:A1:now","headword":"now","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:now","pos":"adverb","gloss":"حالا؛ الان","meaning":"در همین لحظه یا در این دوره. right now = همین الان. برای کاری که الان در جریان است، حال استمراری می‌آید.","grammar":[{"pattern":"subject + verb + now","note":"I'm busy now."},{"pattern":"right now","note":"همین الان"},{"pattern":"from now on","note":"از این به بعد"}],"examples":[{"en":"I am at home now.","fa":"الان خانه‌ام."},{"en":"Let's go now, or we'll be late.","fa":"بیا حالا برویم، وگرنه دیر می‌رسیم."}],"collocations":["right now","just now","from now on","for now"],"mistake":{"wrong":"I study now, so I can't talk.","right":"I'm studying now, so I can't talk.","why":"برای کاری که همین الان در جریان است، حال استمراری (am studying) می‌آید."},"pronunciation":{"gb":"/naʊ/","us":"/naʊ/"},"check":[{"type":"cloze","id":"c1","text":"Where are you ___? – At the station.","answer":"now","accept":[],"fa":"الان کجایی؟ – ایستگاهم.","why":"now = الان."},{"type":"choice","id":"q1","prompt":"Be quiet! The baby ___ now.","options":[{"text":"is sleeping","ok":true,"why":"کار در جریان: حال استمراری."},{"text":"sleeps","ok":false,"why":"حال ساده برای عادت است، نه همین الان."},{"text":"sleep","ok":false,"why":"فاعل سوم‌شخص است و کار در جریان است."}]},{"type":"produce","id":"p1","prompt":"همین الان برو!","frame":"Go right ___!","answer":"now","accept":[],"why":"right now = همین الان."}]}],"version":"39e4c2bca964","order":133,"unit":2,"prerequisites":["lex:A1:time"],"released":false},{"id":"lex:A1:later","headword":"later","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:later","pos":"adverb","gloss":"بعداً","meaning":"در زمانی بعد از حالا. See you later! = بعداً می‌بینمت. two days later = دو روز بعد.","grammar":[{"pattern":"See you later!","note":"بعداً می‌بینمت!"},{"pattern":"time + later","note":"two hours later"},{"pattern":"later today","note":"امروز بعداً"}],"examples":[{"en":"I'm busy now. I'll call you later.","fa":"الان سرم شلوغ است. بعداً زنگ می‌زنم."},{"en":"He left, and three days later he came back.","fa":"او رفت و سه روز بعد برگشت."}],"collocations":["see you later","later today","two days later","later on"],"mistake":{"wrong":"I'll call you more late.","right":"I'll call you later.","why":"«بعداً»: later."},"pronunciation":{"gb":"/ˈleɪtə/","us":"/ˈleɪtər/"},"check":[{"type":"cloze","id":"c1","text":"I can't talk now. Can I call you ___?","answer":"later","accept":["back"],"fa":"الان نمی‌توانم صحبت کنم. بعداً زنگ بزنم؟","why":"later = بعداً."},{"type":"choice","id":"q1","prompt":"Bye! See you ___!","options":[{"text":"later","ok":true,"why":"See you later!"},{"text":"late","ok":false,"why":"late یعنی دیر."},{"text":"lately","ok":false,"why":"lately یعنی اخیراً."}]},{"type":"produce","id":"p1","prompt":"بعداً انجامش می‌دهم.","frame":"I'll do it ___.","answer":"later","accept":[],"why":"later = بعداً."}]}],"version":"7d5384b85532","order":134,"unit":2,"prerequisites":["lex:A1:time","lex:A1:after"],"released":false},{"id":"lex:A1:soon","headword":"soon","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:soon","pos":"adverb","gloss":"به‌زودی؛ زود","meaning":"بعد از مدت کوتاهی. as soon as possible = هرچه زودتر. See you soon = به‌زودی می‌بینمت.","