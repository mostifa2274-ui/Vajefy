{"entries":[{"id":"lex:A1:hour","headword":"hour","goals":["everyday","work","study","general"],"senses":[{"id":"lex:A1:hour","pos":"noun","gloss":"ساعت (مدت)","meaning":"مدت شصت دقیقه. h در آن خوانده نمی‌شود، پس an hour. برای پرسیدن زمان از What time …? استفاده می‌کنیم، نه hour.","grammar":[{"pattern":"an hour / two hours","note":"یک ساعت / دو ساعت"},{"pattern":"for an hour","note":"به مدت یک ساعت"},{"pattern":"half an hour","note":"نیم ساعت"}],"examples":[{"en":"The lesson is one hour long.","fa":"درس یک ساعت طول می‌کشد."},{"en":"I waited for half an hour at the bus stop.","fa":"نیم ساعت در ایستگاه اتوبوس منتظر ماندم."}],"collocations":["an hour","half an hour","for hours","every hour"],"mistake":{"wrong":"What hour is it?","right":"What time is it?","why":"«ساعت چند است؟» را با What time می‌پرسیم؛ hour یعنی مدت شصت دقیقه."},"pronunciation":{"gb":"/ˈaʊə/","us":"/ˈaʊɚ/","note":"h خوانده نمی‌شود: «آوِر»؛ با our هم‌صداست."},"check":[{"type":"cloze","id":"c1","text":"The train to Tabriz takes about ten ___.","answer":"hours","accept":[],"fa":"قطار تبریز حدود ده ساعت طول می‌کشد.","why":"مدت: hours."},{"type":"choice","id":"q1","prompt":"I'll be back in ___ hour.","options":[{"text":"an","ok":true,"why":"h خوانده نمی‌شود، پس an."},{"text":"a","ok":false,"why":"hour با صدای واکه شروع می‌شود."},{"text":"one of","ok":false,"why":"one of بعدش اسم جمع می‌آید."}]},{"type":"produce","id":"p1","prompt":"نیم ساعت منتظر ماندم.","frame":"I waited for half an ___.","answer":"hour","accept":[],"why":"half an hour = نیم ساعت."}]}],"version":"3404b19c7963","order":125,"unit":2,"prerequisites":["lex:A1:time"],"released":false},{"id":"lex:A1:monday","headword":"Monday","goals":["everyday","general"],"senses":[{"id":"lex:A1:monday","pos":"noun","gloss":"دوشنبه","meaning":"روز بعد از یکشنبه؛ در کشورهای انگلیسی‌زبان اولین روز کاری هفته. با حرف بزرگ نوشته می‌شود و با on می‌آید.","grammar":[{"pattern":"on Monday / on Mondays","note":"دوشنبه / دوشنبه‌ها"},{"pattern":"next / last Monday","note":"بدون on"},{"pattern":"Monday morning","note":"دوشنبه صبح"}],"examples":[{"en":"I have class on Monday.","fa":"دوشنبه کلاس دارم."},{"en":"The museum is closed on Mondays.","fa":"موزه دوشنبه‌ها تعطیل است."}],"collocations":["on Monday","next Monday","Monday morning","every Monday"],"mistake":{"wrong":"I'll see you monday.","right":"I'll see you on Monday.","why":"اسم روزها با حرف بزرگ نوشته می‌شود و معمولاً با on می‌آید."},"pronunciation":{"gb":"/ˈmʌndeɪ/","us":"/ˈmʌndeɪ/","note":"o مثل «اَ»: «ماندِی»."},"check":[{"type":"cloze","id":"c1","text":"I start my new job next ___.","answer":"Monday","accept":[],"fa":"دوشنبهٔ آینده کار جدیدم را شروع می‌کنم.","why":"next Monday، بدون on."},{"type":"choice","id":"q1","prompt":"We have a meeting ___ Monday morning.","options":[{"text":"on","ok":true,"why":"on + روز."},{"text":"in","ok":false,"why":"in برای ماه و فصل است."},{"text":"at","ok":false,"why":"at برای ساعت است."}]},{"type":"produce","id":"p1","prompt":"دوشنبه‌ها شنا می‌روم.","frame":"I go swimming on ___.","answer":"Mondays","accept":["Monday"],"why":"on Mondays = دوشنبه‌ها."}]}],"version":"bdc79b826581","order":126,"unit":2,"prerequisites":["lex:A1:week","lex:A1:day"],"released":false},{"id":"lex:A1:tuesday","headword":"Tuesday","goals":["everyday","general"],"senses":[{"id":"lex:A1:tuesday","pos":"noun","gloss":"سه‌شنبه","meaning":"روزِ بعد از دوشنبه. همیشه با حرف بزرگ نوشته می‌شود. on Tuesday = سه‌شنبه؛ on Tuesdays = سه‌شنبه‌ها.","grammar":[{"pattern":"on Tuesday","note":"سه‌شنبه"},{"pattern":"on Tuesdays","note":"سه‌شنبه‌ها"},{"pattern":"Tuesday morning / night","note":"صبح / شبِ سه‌شنبه"}],"examples":[{"en":"I have English classes on Tuesdays.","fa":"سه‌شنبه‌ها کلاس انگلیسی دارم."},{"en":"The shop is closed on Tuesday.","fa":"مغازه سه‌شنبه بسته است."}],"collocations":["on Tuesday","on Tuesdays","Tuesday morning","next Tuesday"],"mistake":{"wrong":"See you in Tuesday.","right":"See you on Tuesday.","why":"با روزها on می‌آید."},"pronunciation":{"gb":"/ˈtjuːzdeɪ/","us":"/ˈtuːzdeɪ/"},"check":[{"type":"cloze","id":"c1","text":"Monday, ___, Wednesday.","answer":"Tuesday","accept":[],"fa":"دوشنبه، سه‌شنبه، چهارشنبه.","why":"روزِ بعد از Monday: Tuesday."},{"type":"choice","id":"q1","prompt":"What do you do ___ Tuesday evenings?","options":[{"text":"on","ok":true,"why":"با روزها on می‌آید."},{"text":"in","ok":false,"why":"in Tuesday غلط است."},{"text":"at","ok":false,"why":"at Tuesday غلط است."}]},{"type":"produce","id":"p1","prompt":"سه‌شنبه می‌بینمت.","frame":"See you on ___.","answer":"Tuesday","accept":[],"why":"on Tuesday."}]}],"version":"7f19a4fa51e3","order":127,"unit":2,"prerequisites":["lex:A1:week","lex:A1:day"],"released":false},{"id":"lex:A1:wednesday","headword":"Wednesday","goals":["everyday","general"],"senses":[{"id":"lex:A1:wednesday","pos":"noun","gloss":"چهارشنبه","meaning":"روزِ بعد از سه‌شنبه. با حرف بزرگ و با on می‌آید. d اول و e وسط تلفظ نمی‌شوند: «وِنزدِی».","grammar":[{"pattern":"on Wednesday / on Wednesdays","note":"چهارشنبه / چهارشنبه‌ها"},{"pattern":"next / last Wednesday","note":"بدون on"},{"pattern":"Wednesday morning","note":"چهارشنبه صبح"}],"examples":[{"en":"My brother comes home every Wednesday.","fa":"برادرم هر چهارشنبه به خانه می‌آید."},{"en":"The shop is closed on Wednesday afternoon.","fa":"مغازه چهارشنبه بعدازظهر تعطیل است."}],"collocations":["on Wednesday","next Wednesday","Wednesday morning","every Wednesday"],"mistake":{"wrong":"See you on wensday.","right":"See you on Wednesday.","why":"املا: Wednesday (با d و حرف بزرگ)."},"pronunciation":{"gb":"/ˈwenzdeɪ/","us":"/ˈwenzdeɪ/","note":"«وِنزدِی»: d اول تلفظ نمی‌شود."},"check":[{"type":"cloze","id":"c1","text":"Tuesday, ___, Thursday.","answer":"Wednesday","accept":[],"fa":"سه‌شنبه، چهارشنبه، پنجشنبه.","why":"روزِ بعد از Tuesday: Wednesday."},{"type":"choice","id":"q1","prompt":"We have a test ___ Wednesday.","options":[{"text":"on","ok":true,"why":"on + روز."},{"text":"in","ok":false,"why":"in برای ماه و فصل است."},{"text":"at","ok":false,"why":"at برای ساعت است."}]},{"type":"produce","id":"p1","prompt":"چهارشنبه‌ها کلاسِ پیانو دارم.","frame":"I have piano lessons on ___.","answer":"Wednesdays","accept":["Wednesday"],"why":"on Wednesdays = چهارشنبه‌ها."}]}],"version":"da252f088a21","order":128,"unit":2,"prerequisites":["lex:A1:week","lex:A1:day"],"released":false},{"id":"lex:A1:thursday","headword":"Thursday","goals":["everyday","general"],"senses":[{"id":"lex:A1:thursday","pos":"noun","gloss":"پنجشنبه","meaning":"روزِ بعد از چهارشنبه. با حرف بزرگ و با on می‌آید.","grammar":[{"pattern":"on Thursday / on Thursdays","note":"پنجشنبه / پنجشنبه‌ها"},{"pattern":"next / last Thursday","note":"بدون on"},{"pattern":"Thursday morning","note":"پنجشنبه صبح"}],"examples":[{"en":"We have football practice on Thursdays.","fa":"پنجشنبه‌ها تمرینِ فوتبال داریم."},{"en":"The meeting is on Thursday morning.","fa":"جلسه پنجشنبه صبح است."}],"collocations":["on Thursday","next Thursday","Thursday evening","every Thursday"],"mistake":{"wrong":"I'll see you at Thursday.","right":"I'll see you on Thursday.","why":"با روز on می‌آید؛ at برای ساعت است."},"pronunciation":{"gb":"/ˈθɜːzdeɪ/","us":"/ˈθɜːrzdeɪ/"},"check":[{"type":"cloze","id":"c1","text":"Wednesday, ___, Friday.","answer":"Thursday","accept":[],"fa":"چهارشنبه، پنجشنبه، جمعه.","why":"روزِ بعد از Wednesday: Thursday."},{"type":"choice","id":"q1","prompt":"The shop is closed ___ Thursday afternoon.","options":[{"text":"on","ok":true,"why":"on + روز."},{"text":"in","ok":false,"why":"in برای ماه و فصل است."},{"text":"at","ok":false,"why":"at برای ساعت است."}]},{"type":"produce","id":"p1","prompt":"پنجشنبه‌ها خانه‌ام.","frame":"I'm at home on ___.","answer":"Thursdays","accept":["Thursday"],"why":"on Thursdays = پنجشنبه‌ها."}]}],"version":"2636dd32c139","order":129,"unit":2,"prerequisites":["lex:A1:week","lex:A1:day"],"released":false},{"id":"lex:A1:friday","headword":"Friday","goals":["everyday","general"],"senses":[{"id":"lex:A1:friday","pos":"noun","gloss":"جمعه","meanin