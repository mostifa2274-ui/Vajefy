{
  "name": "vajefy",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/clean-build.mjs && vite build && node scripts/inject-sw-assets.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "node scripts/cloudflare-ci-bootstrap.mjs",
    "verify:workers-build": "node scripts/verify-workers-build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "validate:data": "node scripts/validate-data.mjs && node scripts/plan-catalogue.mjs --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/build-content.ts --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/curriculum-a1.ts --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/lint-content.ts --strict && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/build-coach-cases.ts --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/reference-notes.ts build --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/audit-catalogue.ts --check && node scripts/build-usefulness.mjs --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/a1-calibration.ts --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/a1-calibration.ts --strict-language && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/review-queue.ts --scope calibration --check && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/review-queue.ts --scope pilot --check",
    "content:build": "node scripts/plan-catalogue.mjs && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/build-content.ts && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/lint-content.ts && node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/reference-notes.ts build && node scripts/build-usefulness.mjs",
    "content:audit": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/audit-catalogue.ts",
    "content:notes": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/reference-notes.ts",
    "content:approve": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/approve-content.ts",
    "content:status": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/content-status.ts",
    "curriculum:status": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/curriculum-a1.ts",
    "curriculum:json": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/curriculum-a1.ts --json",
    "curriculum:complete": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/curriculum-a1.ts --complete",
    "content:lint": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/lint-content.ts",
    "content:scaffold": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/content-drafts.ts scaffold",
    "content:drafts": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/content-drafts.ts check",
    "content:promote": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/content-drafts.ts promote",
    "content:audio": "echo 'See docs/AUDIO.md: python scripts/audio/generate_audio.py --models <dir>' && exit 1",
    "evaluate": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/evaluate-schedulers.ts",
    "coach:cases": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/build-coach-cases.ts",
    "coach:eval": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/evaluate-coach.ts",
    "test": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs --test 'src/lib/learn/**/*.test.ts' 'src/api/**/*.test.ts'",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "cf-typegen": "wrangler types",
    "content:calibration": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/a1-calibration.ts",
    "content:calibration:language": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/a1-calibration.ts --strict-language",
    "content:calibration:tasks": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/a1-calibration.ts --strict-tasks",
    "content:review-queue": "node --experimental-strip-types --no-warnings --import ./scripts/ts-test-register.mjs scripts/review-queue.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "ts-fsrs": "5.4.2",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "ts-fsrs-next": "npm:ts-fsrs@6.0.0-beta.12",
    "typescript-eslint": "^8.56.1",
    "wrangler": "^4.147.0"
  }
}
